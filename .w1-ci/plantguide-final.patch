+/** Public contracts matching PlantGuide's Python app SDK payloads. */
+
+export interface IdentifyRequest {
+  tags: string | string[];
+  top_k?: number;
+}
+
+export interface CareRequest {
+  species_id: string;
+}
+
+export interface PlantMatch {
+  species_id: string | null;
+  common_name: string | null;
+  scientific_name: string | null;
+  score: number;
+  tag_overlap: string[];
+  matched_tags: string[];
+  species_only_tags: string[];
+  query_only_tags: string[];
+  confidence: number;
+  explanation: string;
+}
+
+export interface CareCard {
+  species_id: string | null;
+  common_name: string | null;
+  scientific_name: string | null;
+  summary: string;
+  light: string;
+  water: string;
+  soil: string;
+  humidity: string;
+  temperature_c: string | number;
+  fertilizer: string;
+  toxicity: string;
+  common_issues: string[];
+  tips: string[];
+  integration_version?: "plantguide.sdk.v1";
+}
+
+export interface IdentifyResponse {
+  query_tags: string[];
+  matches: PlantMatch[];
+  model: string;
+  integration_version: "plantguide.sdk.v1";
+  ready_for_ui: boolean;
+  top_care?: CareCard;
+  top_species_id?: string | null;
+  sample_id?: string | null;
+  source?: string;
+  expected_species?: string | null;
+  hit_top1?: boolean;
+  [key: string]: unknown;
+}
