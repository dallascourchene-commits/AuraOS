FROM python:3.12-slim

WORKDIR /app

ENV PYTHONPATH=/app \
    PYTHONHASHSEED=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY . .

RUN python -m pip install --no-cache-dir pytest \
    && useradd -m -u 1000 aura \
    && chown -R aura:aura /app

USER aura

ENTRYPOINT ["python", "scripts/run_emergent_coding_audit.py"]
