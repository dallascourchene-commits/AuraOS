"""Apply the bounded SCO temporal-persistence integration to existing Arena owners."""
from __future__ import annotations

from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def write(path: str, content: str) -> None:
    (ROOT / path).write_text(content, encoding="utf-8")


def replace_once(path: str, old: str, new: str) -> None:
    text = read(path)
    if new in text:
        return
    count = text.count(old)
    if count != 1:
        raise RuntimeError(f"{path}: expected one integration anchor, found {count}")
    write(path, text.replace(old, new, 1))


def insert_before(path: str, marker: str, insertion: str, sentinel: str) -> None:
    text = read(path)
    if sentinel in text:
        return
    count = text.count(marker)
    if count != 1:
        raise RuntimeError(f"{path}: expected one insertion marker, found {count}")
    write(path, text.replace(marker, insertion + marker, 1))



def patch_state_ledger_facade() -> None:
    path = "aura_refactor_state_ledger.py"
    replace_once(
        path,
        "from aura_refactor_state_ledger_metrics import (\n"
        "    bounded_state_ledger_text,\n"
        "    measure_state_preservation,\n"
        ")\n",
        "from aura_refactor_state_ledger_metrics import (\n"
        "    bounded_state_ledger_text,\n"
        "    measure_state_preservation,\n"
        ")\n"
        "from aura_temporal_persistence import (\n"
        "    TemporalCheckpointRegistry,\n"
        "    checkpoint_refactor_state,\n"
        "    verify_refactor_checkpoint,\n"
        ")\n",
    )
    replace_once(
        path,
        '    "reconstruct_state_from_ledger",\n]',
        '    "reconstruct_state_from_ledger",\n'
        '    "TemporalCheckpointRegistry",\n'
        '    "checkpoint_refactor_state",\n'
        '    "verify_refactor_checkpoint",\n'
        ']',
    )

def patch_coding_workbench() -> None:
    path = "aura_coding_workbench_wfst_adapter.py"
    replace_once(
        path,
        "from aura_arena_experience import build_arena_experience, sanitize_experience_payload\n",
        "from aura_arena_experience import build_arena_experience, sanitize_experience_payload\n"
        "from aura_arena_persistence_adapters import ArenaPersistenceCoordinator\n",
    )
    replace_once(
        path,
        '        self._ledger_error = ""\n        if restore and self.session_path.exists():\n',
        '        self._ledger_error = ""\n'
        '        self.persistence = ArenaPersistenceCoordinator(str(self.repo_root))\n'
        '        if restore and self.session_path.exists():\n',
    )
    replace_once(
        path,
        '            "automatic_merge": False,\n        }\n\n    def route_command(\n',
        '            "automatic_merge": False,\n'
        '            "temporal_persistence_enabled": True,\n'
        '        }\n\n'
        '    def route_command(\n',
    )
    methods = """    def checkpoint_state(
        self,
        *,
        repo_head: str,
        parent_checkpoint_id: str = "",
        branch_name: str = "",
    ) -> dict[str, Any]:
        # Persist the current Coding Workbench projection without applying restore.
        result = self.persistence.checkpoint_coding_workbench(
            self,
            repo_head=repo_head,
            parent_checkpoint_id=parent_checkpoint_id,
            branch_name=branch_name,
        )
        checkpoint_id = str((result.get("checkpoint") or {}).get("checkpoint_id") or "")
        if checkpoint_id:
            self._event("checkpoint", checkpoint_id)
        return result

    def assess_checkpoint(
        self,
        checkpoint_id: str,
        *,
        current_repo_head: str,
        current_invariant_values: dict[str, Any] | None = None,
        remaining_context_tokens: int = 0,
        surgeon_context_limit: int = 0,
    ) -> dict[str, Any]:
        # Return a fail-closed restoration assessment; never mutate live state.
        return self.persistence.assess(
            checkpoint_id,
            current_repo_head=current_repo_head,
            current_invariant_values=current_invariant_values,
            remaining_context_tokens=remaining_context_tokens,
            surgeon_context_limit=surgeon_context_limit,
        )

    def restoration_packet(
        self,
        checkpoint_id: str,
        *,
        current_repo_head: str,
        current_invariant_values: dict[str, Any] | None = None,
        remaining_context_tokens: int = 0,
        surgeon_context_limit: int = 0,
    ) -> dict[str, Any]:
        return self.persistence.restoration_packet(
            checkpoint_id,
            current_repo_head=current_repo_head,
            current_invariant_values=current_invariant_values,
            remaining_context_tokens=remaining_context_tokens,
            surgeon_context_limit=surgeon_context_limit,
        )

    def list_checkpoints(self, *, limit: int = 100) -> dict[str, Any]:
        return self.persistence.list_checkpoints(
            arena_id="coding_workbench",
            session_id=self.session_id,
            limit=limit,
        )

"""
    insert_before(
        path,
        "    def get_state_without_routing(self) -> dict[str, Any]:\n",
        methods,
        "    def checkpoint_state(\n",
    )


