FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AURA_REPO_ROOT=/opt/aura \
    AURA_CONNECTOR_HOST=0.0.0.0 \
    AURA_CONNECTOR_PORT=8091

WORKDIR /opt/aura
COPY requirements.txt /opt/aura/requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY . /opt/aura
RUN useradd --create-home --uid 10001 aura \
    && mkdir -p /opt/aura/Aura_Memory /opt/aura/Aura_Staging \
    && chown -R aura:aura /opt/aura

USER aura
EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=3).read()"

ENTRYPOINT ["python", "aura_arena_connector_server.py"]
