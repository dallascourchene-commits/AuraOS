# syntax=docker/dockerfile:1

# Deliberately no default: callers must provide an immutable Aura runtime base
# containing Python, Git, pytest, and every pyproject runtime dependency.
ARG AURA_GATE_BASE_IMAGE
FROM ${AURA_GATE_BASE_IMAGE} AS aura-gate-runtime

ARG AURA_GATE_BASE_IMAGE
RUN python -c "import os,re,sys; value=os.environ.get('AURA_GATE_BASE_IMAGE', ''); sys.exit(0 if re.fullmatch(r'[^@\s]+@sha256:[0-9a-f]{64}', value) else 64)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Resolve no mutable packages during this build. The digest-pinned base is the
# dependency/toolchain lock; fail the build unless the real Forge/Gate import
# closure and verifier executable are already present.
RUN git --version \
    && git config --system --add safe.directory /opt/aura/repo \
    && python -c "import aiohttp,aiosqlite,arxiv,bs4,cryptography,ddgs,defusedxml,httpx,numpy,wasmtime,watchdog,websockets" \
    && python -m pytest --version

RUN mkdir -p /opt/aura/repo/Aura_Staging /var/lib/aura-gate/state \
    /var/lib/aura-gate/audit /var/lib/aura-gate/siem \
    && chown -R 65532:65532 /opt/aura /var/lib/aura-gate

WORKDIR /opt/aura/repo
USER 65532:65532

STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-B", "-m", "aura_gate_server"]
