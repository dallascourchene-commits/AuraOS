+def _fact_items(values: Mapping[Any, Any], field_name: str) -> tuple[tuple[str, Any], ...]:
+    """Normalize fact keys without allowing stringification collisions."""
+
+    normalized = tuple((str(key), value) for key, value in values.items())
+    names = [name for name, _ in normalized]
+    if len(names) != len(set(names)):
+        raise ValueError(f"{field_name} contains colliding fact names")
+    return tuple(sorted(normalized, key=lambda item: item[0]))
