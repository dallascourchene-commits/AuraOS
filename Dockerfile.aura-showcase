FROM python:3.11-slim

WORKDIR /app
COPY . .
RUN python -m pip install --no-cache-dir \
    "numpy>=1.26.4,<3.0" \
    "websockets>=12.0,<17.0" \
    "aiosqlite>=0.20.0,<1.0" \
    "ddgs>=6.0,<10.0" \
    "wasmtime>=20.0,<46.0" \
    "aiohttp>=3.9.0,<4.0" \
    "beautifulsoup4>=4.12.0,<5.0" \
    "httpx>=0.27.0,<1.0" \
    "cryptography>=41.0.0,<45.0"
RUN useradd -m -u 1000 aura && chown -R aura:aura /app
USER aura

EXPOSE 8091
CMD ["python", "aura_showcase_server.py", "--host", "0.0.0.0", "--port", "8091", "--demo-project", "winnipeg_pathways"]
