    second=evd(digest=D3); e2=event(second,2,e1.chain_digest,supersedes=(e1.event_id,)); claim=clm((second.evidence_id,)); e3=event(claim,3,e2.chain_digest); state=replay_construction_events((e1,e2,e3)); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10)
    assert not state.conflicts and report.ready

def test_state_round_trip_revalidates_full_event_chain():
    state,*_=basic_state()
    loaded=ConstructionProjectState.from_dict(state.to_dict())
    assert loaded==state


def test_state_round_trip_rejects_persisted_projection_tampering():
    state,*_=basic_state(); payload=state.to_dict(); payload['active_event_ids']=[]
    with pytest.raises(ValueError): ConstructionProjectState.from_dict(payload)


def test_state_round_trip_rejects_nested_event_tampering():
    state,*_=basic_state(); payload=state.to_dict(); payload['events'][0]['actor_id']='other'
    with pytest.raises(ValueError): ConstructionProjectState.from_dict(payload)


def test_readiness_round_trip_and_authority_boundary():
    state,_,claim,_,_=basic_state(); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10)
    assert ConstructionReadinessReport.from_dict(report.to_dict())==report
    payload=report.to_dict(); payload['physical_work_authorized']=True
    with pytest.raises(ValueError): ConstructionReadinessReport.from_dict(payload)

def test_event_timestamps_must_not_move_backward():
    evidence = evd(observed=1)
    first = ConstructionEvent.create(
        ledger_id='construction/P1', sequence_number=1,
        previous_chain_digest=GENESIS_CHAIN_DIGEST, trace_id='trace', record=evidence,
        actor_id='human', actor_type=ActorType.HUMAN, created_at=11,
    )
    claim = clm((evidence.evidence_id,))
    second = ConstructionEvent.create(
        ledger_id='construction/P1', sequence_number=2,
        previous_chain_digest=first.chain_digest, trace_id='trace', record=claim,
        actor_id='human', actor_type=ActorType.HUMAN, created_at=2.5,
    )
    with pytest.raises(ValueError):
        replay_construction_events((first, second))


def test_claim_cannot_downgrade_evidence_privacy():
    evidence = ConstructionEvidence.create(
        scope=sc(), subject_id='wall-1', evidence_class=ConstructionEvidenceClass.DOCUMENT,
        source_ref='restricted-doc', payload_digest=D,
        measurement_class=MeasurementClass.EMPIRICAL, confidence=.9,
        authority_class=ConstructionAuthorityClass.INFORMATIVE,
        privacy_class=ConstructionPrivacyClass.RESTRICTED, observed_at=1, expires_at=50,
    )
    first = event(evidence, 1, GENESIS_CHAIN_DIGEST)
    claim = ConstructionClaim.create(
        scope=sc(), subject_id='wall-1', predicate='installed', value_digest=D2,
        claimant_id='contractor-1', evidence_refs=(evidence.evidence_id,),
        measurement_class=MeasurementClass.EMPIRICAL, confidence=.8,
        authority_class=ConstructionAuthorityClass.CONTRACTOR,
        privacy_class=ConstructionPrivacyClass.PUBLIC, created_at=2, expires_at=50,
    )
    second = event(claim, 2, first.chain_digest)
    report = query_claim_readiness(
        replay_construction_events((first, second)), claim_id=claim.claim_id, now=10,
    )
    assert f'privacy_class_downgrade:{evidence.evidence_id}' in report.blockers


def test_claim_must_preserve_evidence_consent_references():
    evidence = ConstructionEvidence.create(
        scope=sc(), subject_id='wall-1', evidence_class=ConstructionEvidenceClass.DOCUMENT,
        source_ref='sensitive-doc', payload_digest=D,
        measurement_class=MeasurementClass.EMPIRICAL, confidence=.9,
        authority_class=ConstructionAuthorityClass.INFORMATIVE,
        privacy_class=ConstructionPrivacyClass.SENSITIVE,
        consent_refs=('consent-1',), observed_at=1, expires_at=50,
    )
    first = event(evidence, 1, GENESIS_CHAIN_DIGEST)
    claim = ConstructionClaim.create(
        scope=sc(), subject_id='wall-1', predicate='installed', value_digest=D2,
        claimant_id='contractor-1', evidence_refs=(evidence.evidence_id,),
        measurement_class=MeasurementClass.EMPIRICAL, confidence=.8,
        authority_class=ConstructionAuthorityClass.CONTRACTOR,
        privacy_class=ConstructionPrivacyClass.SENSITIVE,
        consent_refs=('consent-2',), created_at=2, expires_at=50,
    )
    second = event(claim, 2, first.chain_digest)
    report = query_claim_readiness(
        replay_construction_events((first, second)), claim_id=claim.claim_id, now=10,
    )
    assert f'missing_consent_propagation:{evidence.evidence_id}' in report.blockers


def test_readiness_report_requires_a_real_state_digest():
    state, _, claim, _, _ = basic_state()
    report = query_claim_readiness(state, claim_id=claim.claim_id, now=10)
    with pytest.raises(ValueError):
        replace(report, state_digest='not-a-digest')


def test_evidence_observed_after_claim_creation_blocks_readiness():
    evidence = evd(observed=10, expires=50)
    first = ConstructionEvent.create(
        ledger_id='construction/P1', sequence_number=1,
        previous_chain_digest=GENESIS_CHAIN_DIGEST, trace_id='trace', record=evidence,
        actor_id='human', actor_type=ActorType.HUMAN, created_at=11,
    )
    claim = ConstructionClaim.create(
        scope=sc(), subject_id='wall-1', predicate='installed', value_digest=D2,
        claimant_id='contractor-1', evidence_refs=(evidence.evidence_id,),
        measurement_class=MeasurementClass.EMPIRICAL, confidence=.8,
        authority_class=ConstructionAuthorityClass.CONTRACTOR,
        privacy_class=ConstructionPrivacyClass.PROJECT, created_at=5, expires_at=50,
    )
    second = ConstructionEvent.create(
        ledger_id='construction/P1', sequence_number=2,
        previous_chain_digest=first.chain_digest, trace_id='trace', record=claim,
        actor_id='human', actor_type=ActorType.HUMAN, created_at=12,
    )
    report = query_claim_readiness(
        replay_construction_events((first, second)), claim_id=claim.claim_id, now=20,
    )
    assert f'evidence_postdates_claim:{evidence.evidence_id}' in report.blockers

def test_failed_replay_does_not_mutate_previously_verified_state():
    state, evidence, claim, first, second = basic_state()
    before = state.to_dict()
    invalid = ConstructionEvent.create(
        ledger_id='construction/P1', sequence_number=3,
        previous_chain_digest=second.chain_digest, trace_id='trace',
        record=claim, actor_id='human', actor_type=ActorType.HUMAN,
        created_at=6.0,
    )
    with pytest.raises(ValueError):
        replay_construction_events((*state.events, invalid))
    assert state.to_dict() == before


def test_persisted_state_rejects_non_string_identity_fields():
    state, *_ = basic_state()
    payload = state.to_dict()
    payload['project_id'] = 1
    with pytest.raises(ValueError):
        ConstructionProjectState.from_dict(payload)


def test_persisted_conflict_does_not_stringify_malformed_fields():
    state, evidence, _, first, _ = basic_state()
    competing = clm((evidence.evidence_id,), value=D3)
    third = event(competing, 3, state.events[-1].chain_digest)
    conflict = replay_construction_events((*state.events, third)).conflicts[0]
    payload = conflict.to_dict()
    payload['state_key'] = 123
    with pytest.raises(ValueError):
        ConstructionConflict.from_dict(payload)


def test_persisted_readiness_rejects_numeric_string_timestamp():
    state, _, claim, _, _ = basic_state()
    report = query_claim_readiness(state, claim_id=claim.claim_id, now=10)
    payload = report.to_dict()
    payload['evaluated_at'] = '10.0'
    with pytest.raises(ValueError, match='canonical finite float'):
        ConstructionReadinessReport.from_dict(payload)


def test_queries_reject_boolean_and_string_time_aliases():
    state, _, claim, _, _ = basic_state()
    with pytest.raises(ValueError, match='must be numeric'):
        query_claim_readiness(state, claim_id=claim.claim_id, now=True)
    with pytest.raises(ValueError, match='must be numeric'):
        query_claim_readiness(state, claim_id=claim.claim_id, now='10.0')
