from dataclasses import replace
import pytest
from aura_event_contracts import ActorType, MeasurementClass
from aura_construction_contracts import *
from aura_construction_state import *

D='a'*32; D2='b'*32; D3='c'*32

def sc(project='P1'): return ConstructionScope(project,'Z1','WP1')
def evd(*, cls=ConstructionEvidenceClass.DOCUMENT, digest=D, observed=1, expires=50, subject='wall-1'):
    return ConstructionEvidence.create(scope=sc(),subject_id=subject,evidence_class=cls,source_ref=f'src-{cls.value}',payload_digest=digest,measurement_class=MeasurementClass.EMPIRICAL,confidence=.9,authority_class=ConstructionAuthorityClass.INFORMATIVE,privacy_class=ConstructionPrivacyClass.PROJECT,observed_at=observed,expires_at=expires)
def clm(evidence_ids, *, value=D2, subject='wall-1'):
    return ConstructionClaim.create(scope=sc(),subject_id=subject,predicate='installed',value_digest=value,claimant_id='contractor-1',evidence_refs=tuple(evidence_ids),measurement_class=MeasurementClass.EMPIRICAL,confidence=.8,authority_class=ConstructionAuthorityClass.CONTRACTOR,privacy_class=ConstructionPrivacyClass.PROJECT,created_at=2,expires_at=50)
def event(record, seq, prev, *, supersedes=(), parents=()):
    return ConstructionEvent.create(ledger_id='construction/P1',sequence_number=seq,previous_chain_digest=prev,trace_id='trace',record=record,actor_id='human',actor_type=ActorType.HUMAN,parent_event_ids=parents,supersedes_event_ids=supersedes,created_at=float(seq+2))
def basic_state(evidence_class=ConstructionEvidenceClass.DOCUMENT):
    evidence=evd(cls=evidence_class); e1=event(evidence,1,GENESIS_CHAIN_DIGEST); claim=clm((evidence.evidence_id,)); e2=event(claim,2,e1.chain_digest,parents=(e1.event_id,)); return replay_construction_events((e1,e2)),evidence,claim,e1,e2

def test_replay_valid_chain():
    state,*_=basic_state(); assert len(state.active_event_ids)==2 and not state.conflicts
def test_sequence_gap_rejected():
    e=evd(); e1=event(e,1,GENESIS_CHAIN_DIGEST); e2=event(clm((e.evidence_id,)),3,e1.chain_digest)
    with pytest.raises(ValueError): replay_construction_events((e1,e2))
def test_previous_digest_mismatch_rejected():
    e=evd(); e1=event(e,1,GENESIS_CHAIN_DIGEST); e2=event(clm((e.evidence_id,)),2,D)
    with pytest.raises(ValueError): replay_construction_events((e1,e2))
def test_missing_parent_rejected():
    e=evd(); e1=event(e,1,GENESIS_CHAIN_DIGEST); e2=event(clm((e.evidence_id,)),2,e1.chain_digest,parents=('missing',))
    with pytest.raises(ValueError): replay_construction_events((e1,e2))
def test_multiple_projects_rejected():
    e=evd(); e1=event(e,1,GENESIS_CHAIN_DIGEST)
    other=ConstructionEvidence.create(scope=sc('P2'),subject_id='wall-1',evidence_class=ConstructionEvidenceClass.DOCUMENT,source_ref='s',payload_digest=D,measurement_class=MeasurementClass.EMPIRICAL,confidence=.9,authority_class=ConstructionAuthorityClass.INFORMATIVE,privacy_class=ConstructionPrivacyClass.PROJECT,observed_at=1)
    e2=ConstructionEvent.create(ledger_id='construction/P2',sequence_number=2,previous_chain_digest=e1.chain_digest,trace_id='trace',record=other,actor_id='human',actor_type=ActorType.HUMAN,created_at=4)
    with pytest.raises(ValueError): replay_construction_events((e1,e2))
def test_conflict_is_preserved():
    evidence=evd(); e1=event(evidence,1,GENESIS_CHAIN_DIGEST); c1=clm((evidence.evidence_id,),value=D2); e2=event(c1,2,e1.chain_digest); c2=clm((evidence.evidence_id,),value=D3); e3=event(c2,3,e2.chain_digest)
    state=replay_construction_events((e1,e2,e3)); assert len(state.conflicts)==1 and len(state.conflicts[0].active_event_ids)==2
def test_supersession_resolves_conflict():
    evidence=evd(); e1=event(evidence,1,GENESIS_CHAIN_DIGEST); c1=clm((evidence.evidence_id,),value=D2); e2=event(c1,2,e1.chain_digest); c2=clm((evidence.evidence_id,),value=D3); e3=event(c2,3,e2.chain_digest,supersedes=(e2.event_id,)); state=replay_construction_events((e1,e2,e3)); assert not state.conflicts and e2.event_id in state.superseded_event_ids
def test_cross_key_supersession_rejected():
    evidence=evd(); e1=event(evidence,1,GENESIS_CHAIN_DIGEST); c1=clm((evidence.evidence_id,)); e2=event(c1,2,e1.chain_digest); c2=clm((evidence.evidence_id,),subject='wall-2'); e3=event(c2,3,e2.chain_digest,supersedes=(e2.event_id,))
    with pytest.raises(ValueError): replay_construction_events((e1,e2,e3))
def test_missing_evidence_blocks():
    evidence=evd(); e1=event(evidence,1,GENESIS_CHAIN_DIGEST)
    bad=ConstructionClaim.create(scope=sc(),subject_id='wall-1',predicate='installed',value_digest=D2,claimant_id='contractor-1',evidence_refs=('missing',),measurement_class=MeasurementClass.EMPIRICAL,confidence=.8,authority_class=ConstructionAuthorityClass.CONTRACTOR,privacy_class=ConstructionPrivacyClass.PROJECT,created_at=2,expires_at=50)
    e2=event(bad,2,e1.chain_digest); state=replay_construction_events((e1,e2))
    report=query_claim_readiness(state,claim_id=bad.claim_id,now=10)
    assert 'missing_evidence:missing' in report.blockers
def test_expired_evidence_blocks():
    state,_,claim,_,_=basic_state(); report=query_claim_readiness(state,claim_id=claim.claim_id,now=60); assert any(x.startswith('evidence_expired') for x in report.blockers)
def test_sensor_only_is_non_dispositive():
    state,_,claim,_,_=basic_state(ConstructionEvidenceClass.SENSOR); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10); assert 'non_dispositive_evidence_only' in report.blockers
def test_human_authority_release_is_preserved_without_blocking_evidence_review():
    state,_,claim,_,_=basic_state(); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10); assert report.ready and report.human_release_required and not report.physical_work_authorized
def test_document_evidence_can_be_ready_for_authority_review():
    state,_,claim,_,_=basic_state(); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10); assert report.ready and report.readiness_class=='EVIDENCE_READY_FOR_AUTHORITY_REVIEW'
def test_unknown_claim_fails_closed():
    state,*_=basic_state(); assert query_claim_readiness(state,claim_id='unknown',now=10).blockers==('claim_not_uniquely_active',)
def test_state_digest_tampering_is_rejected():
    state,*_=basic_state();
    with pytest.raises(ValueError): replace(state,state_digest='bad')
def test_project_query_is_deterministic():
    state,*_=basic_state(); assert query_project_readiness(state,now=10,)==query_project_readiness(state,now=10,)

def test_duplicate_active_record_without_supersession_is_rejected():
    evidence=evd(); e1=event(evidence,1,GENESIS_CHAIN_DIGEST); e2=event(evidence,2,e1.chain_digest)
    with pytest.raises(ValueError): replay_construction_events((e1,e2))

def test_direct_state_projection_bypass_is_rejected_even_with_recomputed_digest():
    from aura_event_contracts import stable_digest
    state,*_=basic_state(); payload=state._identity_payload(); payload['active_event_ids']=[]
    with pytest.raises(ValueError): ConstructionProjectState(project_id=state.project_id,ledger_id=state.ledger_id,events=state.events,active_event_ids=(),superseded_event_ids=state.superseded_event_ids,conflicts=state.conflicts,final_chain_digest=state.final_chain_digest,state_digest=stable_digest(payload))

def test_evidence_scope_mismatch_blocks_readiness():
    broad=ConstructionEvidence.create(scope=ConstructionScope('P1','Z2','WP1'),subject_id='wall-1',evidence_class=ConstructionEvidenceClass.DOCUMENT,source_ref='doc-other-zone',payload_digest=D,measurement_class=MeasurementClass.EMPIRICAL,confidence=.9,authority_class=ConstructionAuthorityClass.INFORMATIVE,privacy_class=ConstructionPrivacyClass.PROJECT,observed_at=1,expires_at=50)
    e1=ConstructionEvent.create(ledger_id='construction/P1',sequence_number=1,previous_chain_digest=GENESIS_CHAIN_DIGEST,trace_id='trace',record=broad,actor_id='human',actor_type=ActorType.HUMAN,created_at=3)
    claim=clm((broad.evidence_id,)); e2=event(claim,2,e1.chain_digest); state=replay_construction_events((e1,e2)); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10)
    assert f'evidence_scope_mismatch:{broad.evidence_id}' in report.blockers

def test_conflicting_evidence_is_preserved_and_blocks_claim():
    first=evd(digest=D); e1=event(first,1,GENESIS_CHAIN_DIGEST)
    second=evd(digest=D3); e2=event(second,2,e1.chain_digest)
    claim=clm((first.evidence_id,)); e3=event(claim,3,e2.chain_digest); state=replay_construction_events((e1,e2,e3)); report=query_claim_readiness(state,claim_id=claim.claim_id,now=10)
    assert any(c.record_kind==ConstructionRecordKind.EVIDENCE.value for c in state.conflicts)
    assert f'conflicting_evidence:{first.evidence_id}' in report.blockers

def test_evidence_supersession_resolves_evidence_conflict():
    first=evd(digest=D); e1=event(first,1,GENESIS_CHAIN_DIGEST)
