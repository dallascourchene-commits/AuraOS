{
  "version": "AURA_RUNTIME_PROFILE_V1",
  "profile_id": "construction-demo-browser",
  "objective": "Boot the deterministic Construction Arena server in an isolated Python environment, drive the real browser surface, verify all controls and representation modes, complete the director tour, and capture bounded runtime evidence without mutating source.",
  "environment": {
    "create_venv": true,
    "requirements": [
      "requirements.txt"
    ]
  },
  "server": {
    "command": [
      "{python}",
      "aura_spatial_cli.py",
      "--repo-root",
      "{repo}",
      "construction-video-demo",
      "--tour",
      "full",
      "--host",
      "127.0.0.1",
      "--port",
      "8767",
      "--serve"
    ],
    "readiness_url": "http://127.0.0.1:8767/api/construction-demo",
    "readiness_timeout_seconds": 60
  },
  "probe": {
    "command": [
      "node",
      "tests/runtime/construction_demo_browser_probe.cjs"
    ],
    "timeout_seconds": 120,
    "env": {
      "AURA_CONSTRUCTION_DEMO_URL": "http://127.0.0.1:8767/demo/construction",
      "AURA_RUNTIME_EVIDENCE_DIR": "{output}"
    },
    "required_artifacts": [
      "browser-evidence.json",
      "initial.png",
      "initial-canvas.png",
      "mode-MESH-canvas.png",
      "mode-SPLATS-canvas.png",
      "mode-HYBRID-canvas.png",
      "after-tour.png"
    ],
    "success_json": "browser-evidence.json",
    "success_field": "ok"
  },
  "verification_commands": [
    {
      "command": [
        "node",
        "--check",
        "aura_spatial_web/construction_demo_app.js"
      ],
      "timeout_seconds": 30
    },
    {
      "command": [
        "node",
        "--check",
        "aura_spatial_web/construction_scene_renderer.js"
      ],
      "timeout_seconds": 30
    },
    {
      "command": [
        "node",
        "--check",
        "aura_spatial_web/construction_wireframe_pass.js"
      ],
      "timeout_seconds": 30
    },
    {
      "command": [
        "node",
        "--test",
        "tests/js/spatial-construction-demo.test.mjs",
        "tests/js/spatial-construction-review-regressions.test.mjs",
        "tests/js/spatial-gaussian-covariance.test.mjs"
      ],
      "timeout_seconds": 180
    }
  ],
  "axiom_bindings": [
    "observe_runtime_before_mutation",
    "preserve_source_truth_separate_from_presentation_truth",
    "classify_performance_evidence_separately_from_integrity_evidence",
    "bind_every_repair_to_exact_runtime_artifacts_and_repository_identity",
    "dissolve_all_runtime_resources_after_proof",
    "keep_patch_and_merge_authority_outside_the_harness"
  ]
}
