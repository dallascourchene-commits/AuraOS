+def test_fusion_agent_falls_back_and_records_actual_route(tmp_path):
+    agent = AuraFusionAgent(
+        name="thinker",
+        role="THINKER",
+        provider="deepseek",
+        base_url="https://api.deepseek.com/chat/completions",
+        api_key_name="DEEPSEEK_API_KEY",
+        model="deepseek-v4-pro",
+    )
+    judge = AuraFusionAgent(
+        name="judge",
+        role="JUDGE",
+        provider="deepseek",
+        base_url="https://api.deepseek.com/chat/completions",
+        api_key_name="DEEPSEEK_API_KEY",
+        model="deepseek-v4-pro",
+    )
+
+    def caller(**kwargs):
+        if kwargs["provider"] == "deepseek":
+            return None, "quota", 0.01, False
+        payload = json.loads(kwargs["messages"][-1]["content"])
+        content = {
+            "role": payload["agent"]["role"],
+            "answer": "fallback",
+            "claims": [],
+            "risks": [],
+            "missing_info": [],
+            "recommended_action": "review",
+            "confidence": 1.0,
+        }
+        return json.dumps(content), None, 0.01, True
+
+    coordinator = AuraFusionCoordinator(
+        secrets={"DEEPSEEK_API_KEY": "ds", "MISTRAL_API_KEY": "mi"},
+        panel=[agent],
+        judge=judge,
+        caller=caller,
+        log_path=str(tmp_path / "fusion.jsonl"),
+    )
+    output = coordinator._run_panel_agent(agent, {"task": "analyze"})
+    assert output["ok"] is True
+    assert output["provider"] == "mistral"
+    assert output["model"] == "mistral-large-latest"
+    assert output["routing"]["fallback_index"] > 0
+
