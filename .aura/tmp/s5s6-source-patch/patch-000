@@ -0,0 +1,164 @@
+name: Aura Spatial S5 and S6 Construction
+
+on:
+  pull_request:
+    paths:
+      - ".github/workflows/aura-spatial-s5-s6-construction.yml"
+      - ".aura/arena_routes/spatial.v1.json"
+      - "aura_spatial_*.py"
+      - "aura_arena_persistence_adapters.py"
+      - "aura_agent_arena_persistence_bridge.py"
+      - "aura_agent_arena_mcp.py"
+      - "scripts/aura_spatial_s5_s6_construction_architect_harness.py"
+      - "tests/test_aura_spatial*.py"
+      - "tests/test_aura_construction*.py"
+      - "tests/test_aura_arena_persistence_adapters.py"
+      - "tests/test_aura_agent_arena_mcp.py"
+      - "README.md"
+      - "USER_GUIDE.md"
+      - ".aura/ARCHITECTURE.md"
+      - "docs/AURA_SPATIAL_S5_S6_CONSTRUCTION.md"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: aura-spatial-s5-s6-construction-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify-s5-s6-construction:
+    runs-on: ubuntu-latest
+    timeout-minutes: 50
+    env:
+      PYTHONHASHSEED: "0"
+      AURA_S5_S6_ARCHITECT_TIMEOUT_SECONDS: "300"
+      AURA_S5_S6_ARCHITECT_TOTAL_TIMEOUT_SECONDS: "900"
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          submodules: false
+
+      - name: Verify exact pull-request head
+        if: github.event_name == 'pull_request'
+        run: |
+          set -euo pipefail
+          observed="$(git rev-parse HEAD)"
+          expected="${{ github.event.pull_request.head.sha }}"
+          test "$observed" = "$expected"
+          echo "$observed" > /tmp/spatial_s5_s6_exact_head.txt
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+
+      - name: Install bounded verification dependencies
+        run: |
+          set -euo pipefail
+          python -m pip install --disable-pip-version-check --only-binary=:all: --require-hashes -r requirement