  "lessons": [
    {
      "confidence": 0.99,
      "defect_class": "authority_alias_bypass",
      "detector_id": "detect_authority_aliases",
      "false_positive_guard": "Only keys whose separator-insensitive normalized form equals a protected authority key are findings.",
      "generalization_scope": [
        "metadata",
        "schemas",
        "interaction packets",
        "scene packets",
        "review adapters"
      ],
      "invariant": "Metadata must never contradict or alias the authority contract.",
      "lesson_id": "PR164-CW-AUTH-001",
      "provenance": {
        "paths": [
          "aura_spatial_interaction.py",
          "aura_spatial_scene.py",
          "schemas/aura_spatial_scene.schema.json"
        ],
        "pr_number": 164,
        "reviewers": [
          "Codex",
          "manual"
        ]
      },
      "repair_pattern": "Normalize security-sensitive keys by case-folding and removing separators, then reject canonical and aliased authority keys recursively.",
      "required_regression": "Exercise camelCase, mixedCase, snake_case, hyphenated, spaced, and fully separator-split aliases at every metadata depth.",
      "trigger": "Untrusted metadata uses camel, mixed, hyphenated, spaced, or separator-split aliases of protected authority fields."
    },
    {
      "confidence": 0.99,
      "defect_class": "protected_authority_override",
      "detector_id": "detect_protected_metadata_overrides",
      "false_positive_guard": "Canonical protected keys with the exact false value remain permitted only where the contract explicitly serializes them.",
      "generalization_scope": [
        "metadata merging",
        "renderer hints",
        "interaction evidence",
        "review receipts"
      ],
      "invariant": "Protected non-authority fields remain exactly false after merging untrusted metadata.",
      "lesson_id": "PR164-CW-AUTH-002",
      "provenance": {
        "paths": [
          "aura_spatial_interaction.py"
        ],
        "pr_number": 164,
        "reviewers": [
          "Codex"
        ]
      },
      "repair_pattern": "Reject protected keys before merge and reassert the immutable false authority envelope after sanitization.",
      "required_regression": "Attempt true, truthy, null, nested, and conflicting values for every protected field.",
      "trigger": "Caller metadata overwrites a protected false authority field or supplies a contradictory canonical value."
    },
    {
      "confidence": 0.99,
      "defect_class": "count_bounded_byte_unbounded",
      "detector_id": "detect_count_without_byte_budget",
      "false_positive_guard": "Computed internal values with a provable fixed-size representation are not treated as attacker-controlled variable evidence.",
      "generalization_scope": [
        "metadata",
        "source refs",
        "WebSocket packets",
        "review comments",
        "scene records"
      ],
      "invariant": "Every attacker-controlled retained evidence path needs count and byte bounds.",
      "lesson_id": "PR164-CW-BND-001",
      "provenance": {
        "paths": [
          "aura_spatial_contracts.py",
          "aura_spatial_interaction.py"
        ],
        "pr_number": 164,
        "reviewers": [
          "Codex",
          "manual"
        ]
      },
      "repair_pattern": "Apply per-item, aggregate, and canonical serialized-byte ceilings before retention or handoff.",
      "required_regression": "Use few extremely large items as well as many small items and assert fail-closed behavior.",
      "trigger": "Attacker-controlled retained evidence has an item count cap but no per-item and aggregate byte caps."
    },
    {
      "confidence": 1.0,
      "defect_class": "noncanonical_interchange_accepted",
      "detector_id": "detect_noncanonical_interchange_acceptance",
      "false_positive_guard": "Order-significant arrays remain valid when their contract explicitly defines order and digest semantics.",
      "generalization_scope": [
        "scene interchange",
        "review lesson registries",
        "cache keys",
        "receipts"
      ],
      "invariant": "Canonical representation equality is checked before accepting an external digest.",
      "lesson_id": "PR164-CW-CANON-001",
      "provenance": {
        "paths": [
          "aura_spatial_scene.py"
        ],
        "pr_number": 164,
        "reviewers": [
          "Codex",
          "manual"
        ]
      },
      "repair_pattern": "Validate structure, ordering, uniqueness, runtime semantics, canonical reconstruction, field equality, then canonical digest.",
      "required_regression": "Reorder and duplicate records/source refs, recompute a digest, and assert rejection.",
      "trigger": "Externally supplied records or set-like fields are unsorted/duplicated yet accepted with a self-consistent digest."
