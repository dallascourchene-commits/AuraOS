        ],
        "pr_number": 164,
        "reviewers": [
          "Codex"
        ]
      },
      "repair_pattern": "Normalize the full bounded candidate set, sort by a stable key, deduplicate, then truncate.",
      "required_regression": "Permute over-cap inputs and assert the same retained subset.",
      "trigger": "A cap is applied to a set-like collection before stable sorting."
    },
