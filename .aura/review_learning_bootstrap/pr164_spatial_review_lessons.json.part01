      "repair_pattern": "Build a stable semantic sort key, deduplicate, then assign identities and compute digests.",
      "required_regression": "Permute equivalent records repeatedly and assert byte-identical canonical output and stable IDs.",
      "trigger": "Set-like records reach ID assignment, digesting, caching, or interchange in caller-provided order."
    },
    {
      "confidence": 0.98,
      "defect_class": "truncate_before_canonicalize",
      "detector_id": "detect_truncate_before_sort",
      "false_positive_guard": "Streaming or priority queues are exempt only when priority ordering is explicit, deterministic, and tested.",
      "generalization_scope": [
