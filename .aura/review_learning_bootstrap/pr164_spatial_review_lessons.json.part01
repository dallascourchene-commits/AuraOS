    {
      "confidence": 0.98,
      "defect_class": "order_dependent_identity",
      "detector_id": "detect_order_dependent_digesting",
      "false_positive_guard": "Do not flag order-significant sequences whose contract explicitly preserves order.",
      "generalization_scope": [
        "topology links",
        "scene records",
        "source refs",
        "review findings"
