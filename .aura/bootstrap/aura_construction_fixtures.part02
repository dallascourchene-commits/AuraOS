    "CONSTRUCTION_FIXTURE_VERSION",
    "PROJECT_ID",
    "LEDGER_ID",
    "ConstructionDemoFixture",
    "build_sco_construction_demo_fixture",
    "build_sco_construction_demo_runtime_packet",
]
