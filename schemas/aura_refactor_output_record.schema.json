{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraos.dev/schemas/aura_refactor_output_record.schema.json",
  "title": "Aura Refactor Output Record",
  "description": "Standard evidence record for engineering quality of a generated refactor patch. Failed gates do not remove partial quality measurements.",
  "type": "object",
  "required": [
    "record_version",
    "quality_standard_version",
    "benchmark_id",
    "run_id",
    "case_id",
    "arm_id",
    "method",
    "output_kind",
    "token_usage",
    "gates",
    "component_scores",
    "working_status",
    "mandatory_gate_passed",
    "failed_required_gates",
    "disposition",
    "standards_mapping",
    "generated_at"
  ],
  "properties": {
    "record_version": {"const": "AURA_REFACTOR_OUTPUT_RECORD_V1"},
    "quality_standard_version": {"const": "AURA_REFACTOR_CODE_QUALITY_STANDARD_V1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "output_kind": {
      "enum": ["UNIFIED_DIFF", "PLAN_ONLY", "SYNTHETIC_CONTROL_FLOW", "OTHER"]
    },
    "repository_commit_sha": {"type": "string"},
    "objective": {"type": "string"},
    "model": {"type": "string"},
    "provider": {"type": "string"},
    "prompt_digest": {"type": "string"},
    "response_digest": {"type": "string"},
    "patch_digest": {"type": "string"},
    "token_usage": {
      "type": "object",
      "description": "Estimated and provider-reported input/output tokens are stored separately.",
      "properties": {
        "input_tokens_estimated": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens_estimated": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens_estimated": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens_reported": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens_reported": {"type": ["integer", "null"], "minimum": 0},
        "reported_cost_usd": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "workload": {"type": "object"},
    "patch_stats": {
      "type": "object",
      "properties": {
        "files_touched": {"type": "array", "items": {"type": "string"}},
        "file_count": {"type": "integer", "minimum": 0},
        "lines_added": {"type": "integer", "minimum": 0},
        "lines_deleted": {"type": "integer", "minimum": 0},
        "total_changed_lines": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "gates": {
      "type": "object",
      "required": [
        "patch_apply",
        "compile",
        "visible_tests",
        "hidden_tests",
        "regression_tests",
        "api_compatibility",
        "scope",
        "security"
      ],
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "engineering_metrics": {"type": "object"},
    "component_scores": {
      "type": "object",
      "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
    },
    "observed_quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "benchmark_quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "measurement_completeness_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "working_status": {
      "enum": ["WORKING", "PARTIALLY_WORKING", "NOT_WORKING", "UNDETERMINED"]
    },
    "mandatory_gate_passed": {"type": "boolean"},
    "failed_required_gates": {"type": "array", "items": {"type": "string"}},
    "disposition": {
      "enum": [
        "ACCEPTED",
        "WORKED_BUT_NOT_ACCEPTABLE",
        "PARTIAL",
        "FAILED",
        "UNDETERMINED",
        "CODE_QUALITY_UNAVAILABLE",
        "UNASSESSED"
      ]
    },
    "standards_mapping": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "UNAVAILABLE", "NOT_APPLICABLE", "NOT_MEASURED"]
        },
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string"},
        "evidence": {}
      },
      "additionalProperties": true
    }
  }
}
