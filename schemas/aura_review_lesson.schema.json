{
  "$defs": {
    "lesson": {
      "additionalProperties": false,
      "properties": {
        "confidence": {"maximum": 1, "minimum": 0, "type": "number"},
        "defect_class": {"maxLength": 200, "minLength": 1, "type": "string"},
        "detector_id": {"pattern": "^detect_[a-z0-9_]+$", "type": "string"},
        "false_positive_guard": {"maxLength": 2000, "minLength": 1, "type": "string"},
        "generalization_scope": {"$ref": "#/$defs/stringArray"},
        "invariant": {"maxLength": 2000, "minLength": 1, "type": "string"},
        "lesson_id": {"pattern": "^PR164-CW-[A-Z]+-[0-9]{3}$", "type": "string"},
        "provenance": {
          "additionalProperties": false,
          "properties": {
            "paths": {"$ref": "#/$defs/stringArray"},
            "pr_number": {"const": 164},
            "reviewers": {"$ref": "#/$defs/stringArray"}
          },
          "required": ["pr_number", "reviewers", "paths"],
          "type": "object"
        },
        "repair_pattern": {"maxLength": 3000, "minLength": 1, "type": "string"},
        "required_regression": {"maxLength": 3000, "minLength": 1, "type": "string"},
        "trigger": {"maxLength": 2000, "minLength": 1, "type": "string"}
      },
      "required": [
        "lesson_id", "detector_id", "defect_class", "trigger", "invariant",
        "repair_pattern", "required_regression", "generalization_scope",
        "false_positive_guard", "provenance", "confidence"
      ],
      "type": "object"
    },
    "scenario": {
      "additionalProperties": false,
      "properties": {
        "candidate": {},
        "code_slice": {},
        "detector_id": {"pattern": "^detect_[a-z0-9_]+$", "type": "string"},
        "expected_finding_code": {"pattern": "^[A-Z0-9_]+$", "type": "string"},
        "scenario_id": {"pattern": "^[a-z0-9-]+$", "type": "string"}
      },
      "required": ["scenario_id", "detector_id", "candidate", "expected_finding_code", "code_slice"],
      "type": "object"
    },
    "stringArray": {
      "items": {"maxLength": 500, "minLength": 1, "type": "string"},
      "maxItems": 50,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "$id": "https://aura.local/schemas/aura_review_lesson.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "automatic_commit": {"const": false},
        "automatic_fix": {"const": false},
        "automatic_merge": {"const": false},
        "automatic_pull_request": {"const": false},
        "automatic_push": {"const": false},
        "human_review_required": {"const": true},
        "patch_authority": {"const": "exact_source_spans_and_hashes_only"},
        "production_mutation": {"const": false},
        "vsa_patch_authority": {"const": false}
      },
      "required": [
        "production_mutation", "automatic_fix", "automatic_commit", "automatic_push",
        "automatic_pull_request", "automatic_merge", "human_review_required",
        "patch_authority", "vsa_patch_authority"
      ],
      "type": "object"
    },
    "created_at": {"format": "date", "type": "string"},
    "lessons": {"items": {"$ref": "#/$defs/lesson"}, "maxItems": 100, "minItems": 1, "type": "array"},
    "merge_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "registry_digest": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "repository_head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "scenarios": {"items": {"$ref": "#/$defs/scenario"}, "maxItems": 200, "minItems": 1, "type": "array"},
    "source_pr": {"minimum": 1, "type": "integer"},
    "truth_boundary": {"const": "review_learning_only"},
    "version": {"const": "AURA_REVIEW_LESSON_REGISTRY_V1"}
  },
  "required": [
    "version", "source_pr", "repository_head", "merge_commit", "created_at",
    "truth_boundary", "authority", "lessons", "scenarios", "registry_digest"
  ],
  "title": "Aura Coding Waboose Review Lesson Registry",
  "type": "object"
}
