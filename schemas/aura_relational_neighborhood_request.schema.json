{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relational_neighborhood_request.schema.json",
  "title": "Aura Relational Neighborhood Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "objective_digest", "seed_participant_ids", "seed_source_refs",
    "max_hops", "max_nodes", "max_edges", "max_candidate_pairs", "max_output_bytes",
    "max_elapsed_ms", "allowed_relation_types", "minimum_truth_class", "include_tests",
    "include_docs", "include_auxiliary", "stop_on_prohibition", "safe_to_patch",
    "production_mutation", "human_review_required", "patch_authority", "vsa_patch_authority"
  ],
  "properties": {
    "schema_version": {"const": "AURA_RELATIONAL_NEIGHBORHOOD_REQUEST_V1"},
    "objective_digest": {"type": "string", "minLength": 1},
    "seed_participant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "seed_source_refs": {"type": "array", "items": {"type": "object"}},
    "max_hops": {"type": "integer", "minimum": 1, "maximum": 3},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_edges": {"type": "integer", "minimum": 1, "maximum": 1024},
    "max_candidate_pairs": {"type": "integer", "minimum": 0, "maximum": 32640},
    "max_output_bytes": {"type": "integer", "minimum": 1},
    "max_elapsed_ms": {"type": "integer", "minimum": 1},
    "allowed_relation_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "minimum_truth_class": {"enum": ["EXACT_SOURCE", "EXACT_DECLARED", "EXACT_RUNTIME", "DERIVED", "ADVISORY", "UNKNOWN"]},
    "include_tests": {"type": "boolean"},
    "include_docs": {"type": "boolean"},
    "include_auxiliary": {"type": "boolean"},
    "stop_on_prohibition": {"type": "boolean"},
    "safe_to_patch": {"const": false},
    "production_mutation": {"const": false},
    "human_review_required": {"const": true},
    "patch_authority": {"const": "exact_source_spans_and_hashes_only"},
    "vsa_patch_authority": {"const": false}
  },
  "anyOf": [
    {"properties": {"seed_participant_ids": {"minItems": 1}}},
    {"properties": {"seed_source_refs": {"minItems": 1}}}
  ]
}
