{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relationship_interface.schema.json",
  "title": "Aura Typed Relationship Interface V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "interface_id", "port_name", "direction", "cardinality",
    "lifecycle", "actor", "boundary", "resource_class", "data_class", "operation"
  ],
  "properties": {
    "schema_version": {"const": "AURA_RELATIONSHIP_INTERFACE_V1"},
    "interface_id": {"type": "string", "minLength": 48, "maxLength": 48},
    "port_name": {"type": "string", "minLength": 1},
    "direction": {"enum": ["INPUT", "OUTPUT", "BIDIRECTIONAL"]},
    "cardinality": {"enum": ["ONE", "OPTIONAL", "MANY"]},
    "lifecycle": {"enum": ["EPHEMERAL", "SESSION", "PERSISTENT"]},
    "actor": {"enum": ["HUMAN", "AGENT", "SYSTEM", "EXTERNAL"]},
    "boundary": {"enum": ["SAME_ARENA", "CROSS_ARENA", "EXTERNAL"]},
    "resource_class": {"enum": ["CODE", "MEMORY", "STATE", "NETWORK", "FILESYSTEM", "GENERIC"]},
    "data_class": {"enum": ["SOURCE", "EVIDENCE", "CONTRACT", "PLAN", "STATE", "GENERIC"]},
    "operation": {"enum": ["READ", "TRANSFORM", "VALIDATE", "PLAN", "WRITE", "EXECUTE"]}
  }
}
