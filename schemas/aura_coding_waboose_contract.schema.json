{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_coding_waboose_contract.schema.json",
  "title": "Coding Waboose Contract V1",
  "description": "Public Coding Waboose envelope over Aura's internal evidence-bound review contract and diagnostic breadboard.",
  "type": "object",
  "required": [
    "version",
    "contract_id",
    "request_digest",
    "repository_head",
    "diff_digest",
    "changed_files",
    "changed_symbols",
    "impact_slice",
    "focus_directives",
    "routing_frame",
    "profile",
    "authority",
    "lifecycle",
    "product",
    "product_contract_version"
  ],
  "properties": {
    "version": {"const": "AURA_REVIEW_CONTRACT_V1"},
    "product": {"const": "Coding Waboose"},
    "product_contract_version": {"const": "AURA_CODING_WABOOSE_CONTRACT_V1"},
    "contract_id": {"type": "string", "minLength": 16},
    "request_digest": {"type": "string", "minLength": 16},
    "repository_head": {"type": "string", "minLength": 1},
    "diff_digest": {"type": "string", "minLength": 16},
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "changed_symbols": {"type": "array", "items": {"type": "object"}},
    "impact_slice": {"type": "array", "items": {"type": "object"}},
    "focus_directives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "directive_id",
          "name",
          "question",
          "risk",
          "direction",
          "required_evidence",
          "max_depth",
          "max_nodes",
          "origin"
        ]
      }
    },
    "routing_frame": {"type": "object"},
    "profile": {"enum": ["precision", "balanced", "exhaustive"]},
    "authority": {
      "type": "object",
      "required": [
        "aura_computes_diff_and_graph",
        "agent_supplies_hypotheses",
        "agent_may_not_self_confirm",
        "planning_proposes",
        "verification_proves",
        "human_authorizes",
        "patch_authority",
        "vsa_patch_authority",
        "production_mutation",
        "automatic_fix",
        "automatic_commit",
        "automatic_push",
        "automatic_pull_request",
        "automatic_merge"
      ],
      "properties": {
        "aura_computes_diff_and_graph": {"const": true},
        "agent_supplies_hypotheses": {"const": true},
        "agent_may_not_self_confirm": {"const": true},
        "planning_proposes": {"const": true},
        "verification_proves": {"const": true},
        "human_authorizes": {"const": true},
        "patch_authority": {"const": "exact_source_spans_and_hashes_only"},
        "vsa_patch_authority": {"const": false},
        "production_mutation": {"const": false},
        "automatic_fix": {"const": false},
        "automatic_commit": {"const": false},
        "automatic_push": {"const": false},
        "automatic_pull_request": {"const": false},
        "automatic_merge": {"const": false}
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "array",
      "prefixItems": [
        {"const": "FRAME"},
        {"const": "DIFF"},
        {"const": "SLICE"},
        {"const": "SCAN"},
        {"const": "INVESTIGATE"},
        {"const": "CORROBORATE"},
        {"const": "RANK"},
        {"const": "DECIDE"},
        {"const": "REPAIR_HANDOFF"},
        {"const": "DISSOLVE"}
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    }
  },
  "additionalProperties": true
}
