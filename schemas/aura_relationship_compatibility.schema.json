{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relationship_compatibility.schema.json",
  "title": "Aura Relationship Compatibility Assessment V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "left_contract_digest",
    "right_contract_digest",
    "outcome",
    "hard_guard_results",
    "required_adapters",
    "missing_evidence",
    "risks",
    "required_verifiers",
    "advisory_score",
    "safe_to_patch",
    "production_mutation",
    "human_review_required",
    "patch_authority",
    "vsa_patch_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "AURA_RELATIONSHIP_COMPATIBILITY_V1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 48,
      "maxLength": 48
    },
    "left_contract_digest": {
      "type": "string",
      "minLength": 1
    },
    "right_contract_digest": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "COMPATIBLE",
        "ADAPTER_REQUIRED",
        "AUXILIARY_ONLY",
        "PROHIBITED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "hard_guard_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "passed",
          "reason"
        ],
        "properties": {
          "code": {
            "enum": [
              "REPOSITORY_IDENTITY",
              "SOURCE_FRESHNESS",
              "CAPABILITY_POLICY_SCOPE",
              "ACTOR_AUTHORITY",
              "PROHIBITED_RELATIONSHIP",
              "RESOURCE_BUDGET",
              "PROOF_READINESS"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true
    },
    "required_adapters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_verifiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "advisory_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "safe_to_patch": {
      "const": false
    },
    "production_mutation": {
      "const": false
    },
    "human_review_required": {
      "const": true
    },
    "patch_authority": {
      "const": "exact_source_spans_and_hashes_only"
    },
    "vsa_patch_authority": {
      "const": false
    }
  }
}
