{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_forge_arena_evidence_contract.schema.json",
  "title": "Aura Forge Arena Evidence Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "contract_id",
    "request_digest",
    "objective",
    "objective_digest",
    "repository",
    "plan_phase_hash",
    "act_capsules",
    "task_evidence",
    "required_gates",
    "allowed_files",
    "worker_contract",
    "authority",
    "lifecycle"
  ],
  "properties": {
    "version": {
      "const": "AURA_FORGE_ARENA_EVIDENCE_CONTRACT_V1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 16
    },
    "request_digest": {
      "type": "string",
      "minLength": 16
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "objective_digest": {
      "type": "string",
      "minLength": 16
    },
    "repository": {
      "type": "object"
    },
    "plan_phase_hash": {
      "type": "string",
      "minLength": 1
    },
    "act_capsules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "task_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "canonical_arena_verifier",
          "hotswap_readiness"
        ]
      }
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worker_contract": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "required": [
        "automatic_commit",
        "automatic_merge",
        "automatic_pull_request",
        "automatic_push",
        "human_authorizes",
        "patch_authority",
        "planning_proposes",
        "production_mutation",
        "verification_proves",
        "vsa_patch_authority"
      ],
      "properties": {
        "patch_authority": {
          "const": "exact_source_spans_and_hashes_only"
        },
        "vsa_patch_authority": {
          "const": false
        },
        "production_mutation": {
          "const": false
        },
        "automatic_commit": {
          "const": false
        },
        "automatic_push": {
          "const": false
        },
        "automatic_pull_request": {
          "const": false
        },
        "automatic_merge": {
          "const": false
        },
        "planning_proposes": {
          "const": true
        },
        "verification_proves": {
          "const": true
        },
        "human_authorizes": {
          "const": true
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "const": [
        "FRAME",
        "GROUND",
        "PLAN",
        "ACT",
        "PROVE",
        "DECIDE",
        "DISSOLVE"
      ]
    }
  }
}
