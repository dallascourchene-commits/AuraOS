{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relational_index.schema.json",
  "title": "Aura Relational Anatomy Index V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "index_id",
    "repository_identity",
    "profile",
    "participants",
    "relations",
    "groups",
    "reverse_indexes",
    "boundary",
    "build_facts",
    "generated_only",
    "safe_to_patch",
    "production_mutation",
    "automatic_fix",
    "automatic_commit",
    "automatic_push",
    "automatic_pull_request",
    "automatic_merge",
    "human_review_required",
    "patch_authority",
    "vsa_patch_authority",
    "index_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "AURA_RELATIONAL_INDEX_V1"
    },
    "index_id": {
      "type": "string",
      "pattern": "^relindex_[0-9a-f]{24}$"
    },
    "repository_identity": {
      "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/repositoryIdentity"
    },
    "profile": {
      "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/profile"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aura.local/schemas/aura_relational_participant.schema.json"
      },
      "description": "Canonical Python validation enforces unique deterministic IDs in linear time."
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://aura.local/schemas/aura_relational_group.schema.json#/$defs/relation"
      },
      "description": "Canonical Python validation enforces unique deterministic IDs in linear time."
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "https://aura.local/schemas/aura_relational_group.schema.json"
      },
      "description": "Canonical Python validation enforces unique deterministic IDs in linear time."
    },
    "reverse_indexes": {
      "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndexes"
    },
    "boundary": {
      "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/boundary"
    },
    "build_facts": {
      "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/buildFacts"
    },
    "generated_only": {
      "const": true
    },
    "safe_to_patch": {
      "const": false
    },
    "production_mutation": {
      "const": false
    },
    "automatic_fix": {
      "const": false
    },
    "automatic_commit": {
      "const": false
    },
    "automatic_push": {
      "const": false
    },
    "automatic_pull_request": {
      "const": false
    },
    "automatic_merge": {
      "const": false
    },
    "human_review_required": {
      "const": true
    },
    "patch_authority": {
      "const": "exact_source_spans_and_hashes_only"
    },
    "vsa_patch_authority": {
      "const": false
    },
    "index_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_head",
        "working_tree_digest",
        "codemap_digest",
        "topology_digest",
        "topology_version",
        "topology_health",
        "connectome_graph_digest",
        "connectome_version",
        "atomic_inventory_digest",
        "atomic_inventory_version",
        "relation_ontology_digest",
        "profile_digest",
        "schema_digest"
      ],
      "properties": {
        "repo_head": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "working_tree_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "codemap_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "topology_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "topology_version": {
          "type": "string",
          "minLength": 1
        },
        "topology_health": {
          "type": [
            "number",
            "null"
          ]
        },
        "connectome_graph_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "connectome_version": {
          "const": "AURA_CAPABILITY_CONNECTOME_V2"
        },
        "atomic_inventory_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "atomic_inventory_version": {
          "const": "AURA_ATOMIC_FUNCTION_INVENTORY_V1"
        },
        "relation_ontology_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "profile_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        },
        "schema_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "budgets",
        "profile_digest"
      ],
      "properties": {
        "name": {
          "enum": [
            "MINIMAL",
            "STANDARD",
            "DEEP"
          ]
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_group_relations",
            "max_group_participants"
          ],
          "properties": {
            "max_group_relations": {
              "type": "integer",
              "minimum": 1
            },
            "max_group_participants": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "profile_digest": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "MINIMAL"
              }
            }
          },
          "then": {
            "properties": {
              "budgets": {
                "properties": {
                  "max_group_relations": {
                    "const": 300
                  },
                  "max_group_participants": {
                    "const": 300
                  }
                }
              },
              "profile_digest": {
                "const": "71a2127322ef7f08c811c9a4d44893f69b0acd66"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "STANDARD"
              }
            }
          },
          "then": {
            "properties": {
              "budgets": {
                "properties": {
                  "max_group_relations": {
                    "const": 1500
                  },
                  "max_group_participants": {
                    "const": 1500
                  }
                }
              },
              "profile_digest": {
                "const": "fbd07346436bc718fdee1fe51dfc4134e90c7950"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "DEEP"
              }
            }
          },
          "then": {
            "properties": {
              "budgets": {
                "properties": {
                  "max_group_relations": {
                    "const": 10000
                  },
                  "max_group_participants": {
                    "const": 10000
                  }
                }
              },
              "profile_digest": {
                "const": "ed1ca2e91606c90af0e6f4dd31642dd7d91ab09d"
              }
            }
          }
        }
      ]
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(relp|rel|relgroup)_[0-9a-f]{24}$"
      }
    },
    "reverseIndex": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/idArray"
      }
    },
    "reverseIndexes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_participant",
        "by_node_id",
        "by_qualified_symbol",
        "by_file_path",
        "by_capability",
        "by_group_kind",
        "by_relation_type",
        "by_test_path",
        "by_schema",
        "by_authority_family",
        "by_arena"
      ],
      "properties": {
        "by_participant": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_node_id": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_qualified_symbol": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_file_path": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_capability": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_group_kind": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_relation_type": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_test_path": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_schema": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_authority_family": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        },
        "by_arena": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/reverseIndex"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsupported_languages",
        "unresolved_dynamic_calls",
        "advisory_only_mappings",
        "excluded_generated_paths",
        "warnings",
        "all_relation_endpoints_present"
      ],
      "properties": {
        "unsupported_languages": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/stringArray"
        },
        "unresolved_dynamic_calls": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/stringArray"
        },
        "advisory_only_mappings": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/stringArray"
        },
        "excluded_generated_paths": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/stringArray"
        },
        "warnings": {
          "$ref": "https://aura.local/schemas/aura_relational_index.schema.json#/$defs/stringArray"
        },
        "all_relation_endpoints_present": {
          "const": true
        }
      }
    },
    "buildFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_version",
        "source_file_count",
        "topology_node_count",
        "topology_edge_count",
        "atomic_callable_count",
        "participant_count",
        "exact_relation_count",
        "advisory_relation_count",
        "group_count",
        "unresolved_mapping_count"
      ],
      "properties": {
        "anchor_version": {
          "const": "AURA_TOPOLOGICAL_CONTEXT_ANCHOR_V1"
        },
        "source_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "topology_node_count": {
          "type": "integer",
          "minimum": 1
        },
        "topology_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "atomic_callable_count": {
          "type": "integer",
          "minimum": 1
        },
        "participant_count": {
          "type": "integer",
          "minimum": 1
        },
        "exact_relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "advisory_relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "group_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_mapping_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
