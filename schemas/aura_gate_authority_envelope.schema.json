{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_gate_authority_envelope.schema.json",
  "title": "Aura Gate Authority Envelope V1",
  "description": "Exact, content-addressed authority compiled by Aura Gate around one retained Aura Forge evidence contract and one canonical Arena lease. Runtime validation additionally verifies content digests and the canonical arena_lease_json snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_id",
    "gate_run_id",
    "actor_ref",
    "identity_basis_digest",
    "policy_id",
    "policy_digest",
    "purpose_digest",
    "forge_run_id",
    "forge_contract_id",
    "forge_contract_digest",
    "repository_digest",
    "arena_lease_json",
    "arena_lease_digest",
    "capabilities",
    "allowed_files",
    "destinations",
    "providers",
    "models",
    "data_classes",
    "egress_fields",
    "retention_classes",
    "required_verifiers",
    "protocol",
    "max_payload_bytes",
    "max_token_estimate",
    "max_output_tokens",
    "max_provider_calls",
    "nonce",
    "issued_at",
    "expires_at",
    "human_review_required",
    "production_mutation",
    "automatic_commit",
    "automatic_push",
    "automatic_pull_request",
    "automatic_merge",
    "automatic_promotion",
    "patch_authority",
    "vsa_patch_authority",
    "version"
  ],
  "properties": {
    "authority_id": {
      "type": "string",
      "pattern": "^GATE-AUTH-sha256:[0-9a-f]{64}$"
    },
    "gate_run_id": {
      "type": "string",
      "pattern": "^GATE-[0-9a-f]{24}$"
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "identity_basis_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^GATE-POLICY-sha256:[0-9a-f]{64}$"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "purpose_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "forge_run_id": {
      "type": "string",
      "pattern": "^FORGE-[0-9a-f]{16}-[0-9a-f]{12}$"
    },
    "forge_contract_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "forge_contract_digest": {
      "$ref": "#/$defs/blake2b256Digest"
    },
    "repository_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "arena_lease_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1000000
    },
    "arena_lease_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "capabilities": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "allowed_files": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "destinations": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "providers": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "models": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "data_classes": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "egress_fields": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "retention_classes": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "required_verifiers": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "protocol": {
      "enum": [
        "NATIVE",
        "MCP",
        "A2A"
      ]
    },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "max_token_estimate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2500000
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 128,
      "maximum": 16000
    },
    "max_provider_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "number",
      "minimum": 0
    },
    "expires_at": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "human_review_required": {
      "const": true
    },
    "production_mutation": {
      "const": false
    },
    "automatic_commit": {
      "const": false
    },
    "automatic_push": {
      "const": false
    },
    "automatic_pull_request": {
      "const": false
    },
    "automatic_merge": {
      "const": false
    },
    "automatic_promotion": {
      "const": false
    },
    "patch_authority": {
      "const": "exact_source_spans_and_hashes_only"
    },
    "vsa_patch_authority": {
      "const": false
    },
    "version": {
      "const": "AURA_GATE_AUTHORITY_ENVELOPE_V1"
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "blake2b256Digest": {
      "type": "string",
      "pattern": "^blake2b-256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}
