{
  "$defs": {
    "budget": {
      "additionalProperties": false,
      "properties": {
        "max_asset_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "type": "integer"
        },
        "max_assets": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "max_cpu_ms_per_frame": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "type": "number"
        },
        "max_entities": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "max_gpu_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "type": "integer"
        },
        "max_links": {
          "maximum": 4000000,
          "minimum": 0,
          "type": "integer"
        },
        "max_network_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_entities",
        "max_links",
        "max_assets",
        "max_asset_bytes",
        "max_cpu_ms_per_frame",
        "max_gpu_bytes",
        "max_network_bytes"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 192,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$",
      "type": "string"
    },
    "nonBlank": {
      "maxLength": 2048,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "renderer": {
      "enum": [
        "WEBXR",
        "WEBGPU",
        "WEBGL2",
        "ACCESSIBLE_2D",
        "HEADLESS"
      ]
    }
  },
  "$id": "https://aura.local/schemas/aura_spatial_render_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "selected_renderer": {
            "const": "WEBXR"
          }
        },
        "required": [
          "selected_renderer"
        ]
      },
      "then": {
        "properties": {
          "xr_user_activation_observed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "selected_renderer": {
              "const": "ACCESSIBLE_2D"
            }
          },
          "required": [
            "selected_renderer"
          ]
        }
      },
      "then": {
        "properties": {
          "fallback_renderers": {
            "contains": {
              "const": "ACCESSIBLE_2D"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "accessible_fallback_required": {
      "const": true
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "device_profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_authority": {
      "const": false
    },
    "fallback_renderers": {
      "items": {
        "$ref": "#/$defs/renderer"
      },
      "type": "array",
      "uniqueItems": true
    },
    "patch_authority": {
      "const": false
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "projection_only": {
      "const": true
    },
    "reasons": {
      "items": {
        "maxLength": 512,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "render_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "renderer_authority": {
      "const": false
    },
    "scene_asset_bytes": {
      "maximum": 1099511627776,
      "minimum": 0,
      "type": "integer"
    },
    "scene_asset_count": {
      "maximum": 100000,
      "minimum": 0,
      "type": "integer"
    },
    "scene_digest": {
      "$ref": "#/$defs/digest"
    },
    "scene_entity_count": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "scene_id": {
      "$ref": "#/$defs/identifier"
    },
    "scene_link_count": {
      "maximum": 4000000,
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0"
    },
    "selected_renderer": {
      "$ref": "#/$defs/renderer"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/nonBlank"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "const": "AURA_SPATIAL_RENDER_CONTRACTS_V1"
    },
    "xr_user_activation_observed": {
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "scene_id",
    "scene_digest",
    "device_profile_digest",
    "selected_renderer",
    "fallback_renderers",
    "budget",
    "scene_entity_count",
    "scene_link_count",
    "scene_asset_count",
    "scene_asset_bytes",
    "reasons",
    "source_refs",
    "accessible_fallback_required",
    "xr_user_activation_observed",
    "projection_only",
    "renderer_authority",
    "execution_authority",
    "patch_authority",
    "version",
    "schema_version",
    "render_plan_digest"
  ],
  "title": "Aura Spatial Render Plan V1",
  "type": "object"
}
