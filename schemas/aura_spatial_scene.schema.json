{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_spatial_scene.schema.json",
  "title": "Aura Spatial Scene Snapshot V1",
  "type": "object",
  "required": [
    "scene_id",
    "purpose_digest",
    "root_frame_id",
    "frames",
    "assets",
    "entities",
    "links",
    "source_refs",
    "renderer_hints",
    "truth_policy",
    "patch_authority",
    "vsa_patch_authority",
    "execution_authority",
    "version",
    "schema_version",
    "scene_digest"
  ],
  "properties": {
    "scene_id": { "$ref": "#/$defs/identifier" },
    "purpose_digest": { "type": "string", "minLength": 1, "maxLength": 512 },
    "root_frame_id": { "$ref": "#/$defs/identifier" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "source_refs": { "$ref": "#/$defs/stringSet" },
    "renderer_hints": { "type": "object" },
    "truth_policy": { "type": "string", "minLength": 1 },
    "patch_authority": { "const": "exact_source_spans_and_hashes_only" },
    "vsa_patch_authority": { "const": false },
    "execution_authority": { "const": false },
    "version": { "const": "AURA_SPATIAL_CONTRACTS_V1" },
    "schema_version": { "const": "1.0" },
    "scene_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "identifierSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "positiveVec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "truthClass": {
      "enum": ["EXACT", "DERIVED", "PRESENTATION", "HYPOTHESIS"]
    },
    "frame": {
      "type": "object",
      "required": [
        "frame_id",
        "parent_frame_id",
        "handedness",
        "up_axis",
        "unit_scale_meters",
        "translation",
        "rotation_xyzw",
        "scale",
        "source_refs",
        "truth_class",
        "projection_only"
      ],
      "properties": {
        "frame_id": { "$ref": "#/$defs/identifier" },
        "parent_frame_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "handedness": { "enum": ["RIGHT_HANDED", "LEFT_HANDED"] },
        "up_axis": { "enum": ["X_UP", "Y_UP", "Z_UP"] },
        "unit_scale_meters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "translation": { "$ref": "#/$defs/vec3" },
        "rotation_xyzw": { "$ref": "#/$defs/quat" },
        "scale": { "$ref": "#/$defs/positiveVec3" },
        "source_refs": { "$ref": "#/$defs/stringSet" },
        "truth_class": { "$ref": "#/$defs/truthClass" },
        "projection_only": { "const": true }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_type",
        "uri",
        "media_type",
        "content_digest",
        "byte_length",
        "frame_id",
        "bounds_min",
        "bounds_max",
        "source_refs",
        "truth_class",
        "immutable",
        "metadata"
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/identifier" },
        "asset_type": {
          "enum": [
            "TOPOLOGY_GRAPH",
            "MESH",
            "POINT_CLOUD",
            "GAUSSIAN_SPLAT",
            "VOXEL",
            "SIGNED_DISTANCE_FIELD",
            "PLANE",
            "ANNOTATION"
          ]
        },
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "content_digest": {
          "type": "string",
          "pattern": "^(sha256|blake2b-256):[0-9a-f]{64}$"
        },
        "byte_length": { "type": "integer", "minimum": 0 },
        "frame_id": { "$ref": "#/$defs/identifier" },
        "bounds_min": { "$ref": "#/$defs/vec3" },
        "bounds_max": { "$ref": "#/$defs/vec3" },
        "source_refs": {
          "allOf": [
            { "$ref": "#/$defs/stringSet" },
            { "minItems": 1 }
          ]
        },
        "truth_class": { "$ref": "#/$defs/truthClass" },
        "immutable": { "const": true },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "entity_id",
        "entity_type",
        "label",
        "frame_id",
        "asset_ids",
        "source_refs",
        "position",
        "rotation_xyzw",
        "scale",
        "truth_class",
        "selectable",
        "projection_only",
        "patch_authority",
        "metadata"
      ],
      "properties": {
        "entity_id": { "$ref": "#/$defs/identifier" },
        "entity_type": {
          "enum": [
            "DOMAIN_NODE",
            "DOMAIN_LINK",
            "ASSET_INSTANCE",
            "ANCHOR",
            "REGION",
            "LABEL",
            "CONTROL"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "frame_id": { "$ref": "#/$defs/identifier" },
        "asset_ids": { "$ref": "#/$defs/identifierSet" },
        "source_refs": { "$ref": "#/$defs/stringSet" },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation_xyzw": { "$ref": "#/$defs/quat" },
        "scale": { "$ref": "#/$defs/positiveVec3" },
        "truth_class": { "$ref": "#/$defs/truthClass" },
        "selectable": { "type": "boolean" },
        "projection_only": { "const": true },
        "patch_authority": { "const": false },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "link_id",
        "source_entity_id",
        "target_entity_id",
        "relation",
        "source_refs",
        "truth_class",
        "directed",
        "projection_only",
        "metadata"
      ],
      "properties": {
        "link_id": { "$ref": "#/$defs/identifier" },
        "source_entity_id": { "$ref": "#/$defs/identifier" },
        "target_entity_id": { "$ref": "#/$defs/identifier" },
        "relation": { "$ref": "#/$defs/identifier" },
        "source_refs": { "$ref": "#/$defs/stringSet" },
        "truth_class": { "$ref": "#/$defs/truthClass" },
        "directed": { "type": "boolean" },
        "projection_only": { "const": true },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
