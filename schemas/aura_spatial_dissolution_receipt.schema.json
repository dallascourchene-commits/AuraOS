{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 192,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$",
      "type": "string"
    },
    "nonBlank": {
      "maxLength": 2048,
      "pattern": ".*\\S.*",
      "type": "string"
    }
  },
  "$id": "https://aura.local/schemas/aura_spatial_dissolution_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automatic_merge": {
      "const": false
    },
    "dissolution_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_authority": {
      "const": false
    },
    "leases_released": {
      "const": true
    },
    "patch_authority": {
      "const": false
    },
    "production_mutation": {
      "const": false
    },
    "raw_sensor_data_retained": {
      "const": false
    },
    "reason_code": {
      "$ref": "#/$defs/identifier"
    },
    "receipt_id": {
      "$ref": "#/$defs/identifier"
    },
    "released_asset_ids": {
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "maxItems": 4096,
      "type": "array",
      "uniqueItems": true
    },
    "render_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "render_receipt_ids": {
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "renderer_authority": {
      "const": false
    },
    "renderer_disposed": {
      "const": true
    },
    "scene_digest": {
      "$ref": "#/$defs/digest"
    },
    "schema_version": {
      "const": "1.0"
    },
    "sequence": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/nonBlank"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_state": {
      "enum": [
        "CANCELLED",
        "FAILED",
        "DISSOLVED"
      ]
    },
    "version": {
      "const": "AURA_SPATIAL_RENDER_CONTRACTS_V1"
    }
  },
  "required": [
    "receipt_id",
    "session_id",
    "scene_digest",
    "render_plan_digest",
    "terminal_state",
    "reason_code",
    "sequence",
    "render_receipt_ids",
    "released_asset_ids",
    "source_refs",
    "renderer_disposed",
    "leases_released",
    "raw_sensor_data_retained",
    "production_mutation",
    "automatic_merge",
    "renderer_authority",
    "execution_authority",
    "patch_authority",
    "version",
    "schema_version",
    "dissolution_digest"
  ],
  "title": "Aura Spatial Dissolution Receipt V1",
  "type": "object"
}
