{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_coding_relationship_compass.schema.json",
  "title": "Aura Coding Relationship Compass Objective Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "objective", "objective_digest",
    "intent_packet_digest", "slots", "repository_head", "target_files",
    "target_symbols", "capabilities", "route_reasons", "zero_model_eligible",
    "safe_to_patch", "production_mutation", "human_review_required",
    "patch_authority", "vsa_patch_authority"
  ],
  "properties": {
    "schema_version": {"const": "AURA_CODING_RELATIONSHIP_COMPASS_OBJECTIVE_V1"},
    "contract_id": {"type": "string", "minLength": 48, "maxLength": 48},
    "objective": {"type": "string", "minLength": 1},
    "objective_digest": {"type": "string", "minLength": 40, "maxLength": 40},
    "intent_packet_digest": {"type": "string", "minLength": 1},
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DIR", "ASP", "CLASS", "SUBJ", "VOICE", "STEM"],
      "properties": {
        "DIR": {"type": "string", "minLength": 1},
        "ASP": {"type": "string", "minLength": 1},
        "CLASS": {"type": "string", "minLength": 1},
        "SUBJ": {"type": "string", "minLength": 1},
        "VOICE": {"type": "string", "minLength": 1},
        "STEM": {"type": "string", "minLength": 1}
      }
    },
    "repository_head": {"type": "string"},
    "target_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 16},
    "target_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 32},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "status", "reasons", "implementation_files", "symbols", "tests", "model_required"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["SELECTED", "ACTIVE", "AUXILIARY", "UNRESOLVED", "PROHIBITED"]},
          "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "implementation_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "tests": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "model_required": {"type": "boolean"}
        }
      }
    },
    "route_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "zero_model_eligible": {"type": "boolean"},
    "safe_to_patch": {"const": false},
    "production_mutation": {"const": false},
    "human_review_required": {"const": true},
    "patch_authority": {"const": "exact_source_spans_and_hashes_only"},
    "vsa_patch_authority": {"const": false}
  }
}
