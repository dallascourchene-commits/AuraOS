{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relationship_prohibition.schema.json",
  "title": "Aura Architecture Relationship Atlas — Relationship Prohibition V1",
  "description": "Schema for representing a relationship pattern that is architecturally or security prohibited from being wired.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prohibition_id",
    "pattern",
    "participant_types",
    "relation_types",
    "prohibition_family",
    "reason",
    "canonical_rule_refs",
    "evidence_refs",
    "exceptions",
    "current_reproof_required"
  ],
  "properties": {
    "prohibition_id": {
      "type": "string",
      "pattern": "^prohib_[0-9a-f]{24}$"
    },
    "pattern": {
      "type": "string",
      "minLength": 1
    },
    "participant_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "relation_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibition_family": {
      "type": "string",
      "enum": [
        "authority",
        "security",
        "privacy",
        "lifecycle",
        "truth_ownership",
        "schema",
        "domain",
        "recursion"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "canonical_rule_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exceptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "current_reproof_required": {
      "type": "boolean"
    }
  }
}
