{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relational_participant.schema.json",
  "title": "Aura Relational Participant V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "participant_id",
    "participant_type",
    "role",
    "truth_class",
    "canonical_owner",
    "canonical_ref",
    "digest",
    "evidence_refs",
    "freshness",
    "qualified_symbol",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "AURA_RELATIONAL_PARTICIPANT_V1"},
    "participant_id": {"type": "string", "pattern": "^relp_[0-9a-f]{24}$"},
    "participant_type": {
      "enum": ["atomic_symbol", "capability", "test", "schema", "state", "verifier", "authority", "arena", "document", "external_effect", "packet"]
    },
    "role": {"type": "string", "minLength": 1},
    "truth_class": {
      "enum": ["EXACT_SOURCE", "EXACT_SCHEMA", "EXACT_TEST", "EXACT_MANIFEST", "EXACT_RUNTIME", "ADVISORY_CONNECTOME", "ADVISORY_AFFINITY", "INFERRED_MOTIF", "UNRESOLVED"]
    },
    "canonical_owner": {"type": "string", "minLength": 1},
    "canonical_ref": {"type": "string", "minLength": 1},
    "digest": {"type": ["string", "null"], "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "freshness": {"enum": ["CURRENT", "STALE", "UNRESOLVED"]},
    "qualified_symbol": {"type": ["string", "null"], "minLength": 1},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"truth_class": {"enum": ["EXACT_SOURCE", "EXACT_SCHEMA", "EXACT_TEST", "EXACT_MANIFEST", "EXACT_RUNTIME"]}}},
      "then": {"properties": {"digest": {"type": "string", "minLength": 1}, "evidence_refs": {"minItems": 1}, "freshness": {"const": "CURRENT"}}}
    },
    {
      "if": {"properties": {"truth_class": {"const": "UNRESOLVED"}}},
      "then": {"properties": {"freshness": {"const": "UNRESOLVED"}}}
    }
  ]
}
