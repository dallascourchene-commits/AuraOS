{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_pascal_source_lock_v1.schema.json",
  "title": "Aura Pascal Source Lock V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packages",
    "local_assets",
    "repository",
    "commit",
    "license",
    "external_asset_fetch",
    "remote_plugin_fetch",
    "persistent_canonical_storage",
    "version",
    "lock_digest"
  ],
  "properties": {
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "package_json_blob_sha1"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "package_json_blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      },
      "maxItems": 4
    },
    "local_assets": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "maxItems": 11,
      "uniqueItems": true
    },
    "repository": {
      "const": "pascalorg/editor"
    },
    "commit": {
      "const": "42ac4be1ce5f3fee74806aa093267b6fee77d47d"
    },
    "license": {
      "const": "MIT"
    },
    "external_asset_fetch": {
      "const": false
    },
    "remote_plugin_fetch": {
      "const": false
    },
    "persistent_canonical_storage": {
      "const": false
    },
    "version": {
      "const": "AURA_PASCAL_SOURCE_LOCK_V1"
    },
    "lock_digest": {
      "const": "672611b98aca61e3ad7a4ebcb32f278916d09d876e663452bb654610562d2e87"
    }
  }
}
