{
  "$defs": {
    "budget": {
      "additionalProperties": false,
      "properties": {
        "max_asset_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "type": "integer"
        },
        "max_assets": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "max_cpu_ms_per_frame": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "type": "number"
        },
        "max_entities": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "max_gpu_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "type": "integer"
        },
        "max_links": {
          "maximum": 4000000,
          "minimum": 0,
          "type": "integer"
        },
        "max_network_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_entities",
        "max_links",
        "max_assets",
        "max_asset_bytes",
        "max_cpu_ms_per_frame",
        "max_gpu_bytes",
        "max_network_bytes"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 192,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$",
      "type": "string"
    },
    "nonBlank": {
      "maxLength": 2048,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "renderer": {
      "enum": [
        "WEBXR",
        "WEBGPU",
        "WEBGL2",
        "ACCESSIBLE_2D",
        "HEADLESS"
      ]
    },
    "safeValue": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/safeValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/safeValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://aura.local/schemas/aura_spatial_device_profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessibility_required": {
      "const": true
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "device_profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_authority": {
      "const": false
    },
    "fingerprinting_allowed": {
      "const": false
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/safeValue"
      },
      "type": "object"
    },
    "network_allowed": {
      "type": "boolean"
    },
    "patch_authority": {
      "const": false
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "renderer_authority": {
      "const": false
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/nonBlank"
      },
      "maxItems": 128,
      "type": "array",
      "uniqueItems": true
    },
    "supported_renderers": {
      "contains": {
        "const": "ACCESSIBLE_2D"
      },
      "items": {
        "$ref": "#/$defs/renderer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "const": "AURA_SPATIAL_RENDER_CONTRACTS_V1"
    },
    "xr_user_activation": {
      "type": "boolean"
    }
  },
  "required": [
    "profile_id",
    "supported_renderers",
    "budget",
    "accessibility_required",
    "xr_user_activation",
    "network_allowed",
    "source_refs",
    "metadata",
    "fingerprinting_allowed",
    "renderer_authority",
    "execution_authority",
    "patch_authority",
    "version",
    "schema_version",
    "device_profile_digest"
  ],
  "title": "Aura Spatial Device Profile V1",
  "type": "object"
}
