{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura_relationship_experience.schema.json",
  "title": "Aura Relationship Experience Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id", "relationship_id", "relationship_digest", "repository_head",
    "working_tree_digest", "valid_from_head", "valid_to_head", "transaction_time",
    "outcome", "verifier_evidence_refs", "receipt_refs", "source_refs",
    "current_source_digest", "human_disposition", "privacy_class", "objective_digest",
    "reason", "version", "proposal_only", "canonical_truth_owner", "patch_authority",
    "vsa_patch_authority", "learned_weight_patch_authority", "promotion_authority",
    "observation_digest"
  ],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^rex_[0-9a-f]{32}$"},
    "relationship_id": {"type": "string", "minLength": 1},
    "relationship_digest": {"type": "string", "minLength": 1},
    "repository_head": {"type": "string", "minLength": 1},
    "working_tree_digest": {"type": "string", "minLength": 1},
    "valid_from_head": {"type": "string", "minLength": 1},
    "valid_to_head": {"type": "string"},
    "transaction_time": {"type": "number"},
    "outcome": {"enum": ["SUCCESS", "FAILURE", "DENIAL", "ABANDONMENT", "ROLLBACK"]},
    "verifier_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "receipt_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "current_source_digest": {"type": "string", "minLength": 1},
    "human_disposition": {"enum": ["APPROVED", "DENIED", "DEFERRED", "NOT_REVIEWED"]},
    "privacy_class": {"enum": ["PUBLIC", "PROJECT", "PRIVATE_REDACTED"]},
    "objective_digest": {"type": "string"},
    "reason": {"type": "string"},
    "version": {"const": "AURA_RELATIONSHIP_EXPERIENCE_V1"},
    "proposal_only": {"const": true},
    "canonical_truth_owner": {"const": false},
    "patch_authority": {"const": "exact_source_spans_and_hashes_only"},
    "vsa_patch_authority": {"const": false},
    "learned_weight_patch_authority": {"const": false},
    "promotion_authority": {"const": false},
    "observation_digest": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
