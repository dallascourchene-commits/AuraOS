+#!/usr/bin/env python3
+"""Claude Code PreToolUse guard for destructive Bash commands.
+
+Reads the hook event JSON on stdin. For Bash tool calls, blocks a bounded set of
+high-risk command patterns required by the bounty. Blocked attempts are appended
+to ~/.claude/hooks/blocked.log and the process exits 2, which Claude Code treats
+as a blocking hook decision.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import shlex
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Iterable
+
+LOG_PATH = Path.home() / ".claude" / "hooks" / "blocked.log"
+
+# These checks are deliberately narrow and auditable. They are not a general
+# shell sandbox and should not be advertised as one.
+RM_COMMAND = re.compile(r"(?:^|[;&|]\s*)(?:sudo\s+)?rm\s+([^\n;&|]+)", re.IGNORECASE)
+DROP_TABLE = re.compile(r"\bDROP\s+TABLE\b", re.IGNORECASE)
+TRUNCATE = re.compile(r"\bTRUNCATE(?:\s+TABLE)?\b", re.IGNORECASE)
+GIT_FORCE_PUSH = re.compile(r"\bgit\s+push\b[^\n;&|]*(?:--force(?:-with-lease|-if-includes)?\b|(?:^|\s)-f(?:\s|$))", re.IGNORECASE)
+DELETE_FROM = re.compile(r"\bDELETE\s+FROM\b", re.IGNORECASE)
+WHERE = re.compile(r"\bWHERE\b", re.IGNORECASE)
+
+
+def _sql_statements(command: str) -> Iterable[str]:
+    """Yield conservative SQL-ish statement fragments.
+
+    Semicolon splitting is sufficient for the required DELETE-without-WHERE gate
+    and errs on the side of blocking ambiguous destructive SQL.
+    """
+    for statement in command.split(";"):
+        statement = statement.strip()
+        if statement:
+            yield statement
+
+
+def _has_recursive_forced_rm(command: str) -> bool:
+    for match in RM_COMMAND.finditer(command):
+        try:
+            args = shlex.split(match.group(1), posix=True)
+        except ValueError:
+            # Ambiguous shell quoting around a destructive rm is safer to block.
+            args = match.group(1).split()
+        flags: set[str] = set()
+        for arg in args:
+            if arg == "--":
+                break
+            if arg.startswith("--"):
+                if arg in {"--recursive", "--force"}:
+                    flags.add("r" if arg == "--recursive" else "f")
+            elif arg.startswith("-") and len(arg) > 1:
+                flags.update(arg[1:])
+            else:
+                break
+        if {"r", "f"}.issubset(flags):
+            return True
+    return False
+
+
+def reasons_for(command: str) -> list[str]:
+    reasons: list[str] = []
+    if _has_recursive_forced_rm(command):
+        reasons.append("recursive forced removal (rm -rf/-fr)")
+    if DROP_TABLE.search(command):
+        reasons.append("DROP TABLE")
+    if TRUNCATE.search(command):
+        reasons.append("TRUNCATE")
+    if GIT_FORCE_PUSH.search(command):
+        reasons.append("forced git push")
+    for statement in _sql_statements(command):
+        match = DELETE_FROM.search(statement)
+        if match and not WHERE.search(statement[match.end() :]):
+            reasons.append("DELETE FROM without WHERE")
+            break
+    return reasons
+
+
+def _project_path(event: dict) -> str:
+    for key in ("cwd", "project_path"):
+        value = event.get(key)
+        if isinstance(value, str) and value.strip():
+            return value.strip()
+    return os.getcwd()
+
+
+def _log_block(command: str, project_path: str, reasons: list[str]) -> None:
+    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
+    record = {
+        "timestamp": datetime.now(timezone.utc).isoformat(),
+        "project_path": project_path,
+        "command": command,
+        "reasons": reasons,
+    }
+    with LOG_PATH.open("a", encoding="utf-8") as handle:
+        handle.write(json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n")
+
+
+def main() -> int:
+    try:
+        event = json.load(sys.stdin)
+    except (json.JSONDecodeError, TypeError) as exc:
+        print(f"Destructive-command hook received invalid JSON: {exc}", file=sys.stderr)
+        return 2
+
+    # Non-Bash tools are outside this hook's scope and pass unchanged.
+    if event.get("tool_name") != "Bash":
+        return 0
+
+    tool_input = event.get("tool_input")
+    command = tool_input.get("command") if isinstance(tool_input, dict) else None
+    if not isinstance(command, str) or not command.strip():
+        return 0
+
+    reasons = reasons_for(command)
+    if not reasons:
+        return 0
+
+    project_path = _project_path(event)
+    _log_block(command, project_path, reasons)
+    print(
+        "Blocked destructive Bash command before execution: " + ", ".join(reasons) + ". "
+        "Revise the command to use a bounded, reversible operation and explicit scope.",
+        file=sys.stderr,
+    )
+    return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
