+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SCRIPT = Path(__file__).with_name("block_destructive_commands.py")
+
+
+def run_hook(command: str, *, tool_name: str = "Bash") -> tuple[subprocess.CompletedProcess[str], Path]:
+    tmp = tempfile.TemporaryDirectory()
+    home = Path(tmp.name)
+    event = {"tool_name": tool_name, "cwd": "/tmp/project", "tool_input": {"command": command}}
+    env = os.environ.copy()
+    env["HOME"] = str(home)
+    result = subprocess.run(
+        [sys.executable, str(SCRIPT)],
+        input=json.dumps(event),
+        text=True,
+        capture_output=True,
+        env=env,
+        check=False,
+    )
+    # Materialize log before TemporaryDirectory cleanup.
+    source = home / ".claude" / "hooks" / "blocked.log"
+    log_copy = Path(tempfile.mkstemp(prefix="hook-log-", suffix=".jsonl")[1])
+    if source.exists():
+        log_copy.write_bytes(source.read_bytes())
+    else:
+        log_copy.write_text("", encoding="utf-8")
+    tmp.cleanup()
+    return result, log_copy
+
+
+class GuardTests(unittest.TestCase):
+    def assertBlocked(self, command: str, reason: str) -> None:
+        result, log = run_hook(command)
+        self.addCleanup(lambda: log.unlink(missing_ok=True))
+        self.assertEqual(result.returncode, 2, result.stderr)
+        self.assertIn(reason, result.stderr)
+        entries = [json.loads(line) for line in log.read_text().splitlines() if line]
+        self.assertEqual(len(entries), 1)
+        self.assertEqual(entries[0]["command"], command)
+        self.assertEqual(entries[0]["project_path"], "/tmp/project")
+        self.assertTrue(entries[0]["timestamp"].endswith("+00:00"))
+
+    def assertAllowed(self, command: str) -> None:
+        result, log = run_hook(command)
+        self.addCleanup(lambda: log.unlink(missing_ok=True))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(log.read_text(), "")
+
+    def test_required_block_patterns(self) -> None:
+        cases = [
+            ("rm -rf build", "recursive forced removal"),
+            ("rm -fr ./cache", "recursive forced removal"),
+            ("psql -c 'DROP TABLE users'", "DROP TABLE"),
+            ("git push --force origin main", "forced git push"),
+            ("git push -f origin feature", "forced git push"),
+            ("sqlite3 app.db 'TRUNCATE TABLE events'", "TRUNCATE"),
+            ("sqlite3 app.db 'DELETE FROM sessions'", "DELETE FROM without WHERE"),
+            ("echo x; DELETE FROM sessions; echo y", "DELETE FROM without WHERE"),
+        ]
+        for command, reason in cases:
+            with self.subTest(command=command):
+                self.assertBlocked(command, reason)
+
+    def test_normal_commands_pass(self) -> None:
+        for command in [
+            "ls -la",
+            "rm -r build",
+            "rm -f artifact.txt",
+            "git push origin feature",
+            "sqlite3 app.db 'DELETE FROM sessions WHERE id = 7'",
+            "sqlite3 app.db 'SELECT * FROM sessions'",
+            "python -m pytest -q",
+        ]:
+            with self.subTest(command=command):
+                self.assertAllowed(command)
+
+    def test_non_bash_tool_passes(self) -> None:
+        result, log = run_hook("rm -rf build", tool_name="Read")
+        self.addCleanup(lambda: log.unlink(missing_ok=True))
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(log.read_text(), "")
+
+    def test_invalid_json_fails_closed(self) -> None:
+        with tempfile.TemporaryDirectory() as home:
+            env = os.environ.copy()
+            env["HOME"] = home
+            result = subprocess.run(
+                [sys.executable, str(SCRIPT)], input="{", text=True, capture_output=True, env=env
+            )
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("invalid JSON", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
