+/** Public contracts matching PlantGuide's Python identify/care payloads. */
+
+export interface IdentifyRequest {
+  tags: string | string[];
+  top_k?: number;
+  with_care?: boolean;
+}
+
+export interface PlantMatch {
+  species_id: string | null;
+  common_name: string | null;
+  scientific_name: string | null;
+  score: number;
+  tag_overlap: string[];
+  matched_tags: string[];
+  species_only_tags: string[];
+  query_only_tags: string[];
+  confidence: number;
+  explanation: string;
+}
+
+export interface CareCard {
+  species_id: string | null;
+  common_name: string | null;
+  scientific_name: string | null;
+  summary: string;
+  light: string;
+  water: string;
+  soil: string;
+  humidity: string;
+  temperature_c: string | number;
+  fertilizer: string;
+  toxicity: string;
+  common_issues: unknown[];
+  tips: unknown[];
+}
+
+export interface IdentifyResponse {
+  query_tags: string[];
+  matches: PlantMatch[];
+  model: "ToyPlantIdentifier";
+  top_care?: CareCard;
+  top_species_id?: string | null;
+  sample_id?: string | null;
+  source?: string;
+  expected_species?: string | null;
+  hit_top1?: boolean;
+  [key: string]: unknown;
+}
