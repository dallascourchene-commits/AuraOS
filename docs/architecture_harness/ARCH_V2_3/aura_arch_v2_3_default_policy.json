{
  "version": "AURA_ARCH_V2_3_DEFAULT_POLICY",
  "controller": {
    "llm_controls_loop": false,
    "llm_may_change_contract": false,
    "llm_may_choose_compaction_survivors": false,
    "llm_may_self_certify_progress": false,
    "candidate_worktree_required": true,
    "llm_may_declare_new_coordination_channel": false,
    "llm_monitor_may_grant_authority": false,
    "llm_may_bypass_commit_authorization": false
  },
  "capsule": {
    "authoritative_format": "json",
    "readable_projection": "markdown",
    "head_binding_required": true,
    "temporary_final_tree_presence_forbidden": true,
    "default_context_token_threshold": 24000,
    "default_patch_transaction_threshold": 40,
    "default_finding_threshold": 75,
    "default_review_wave_threshold": 10,
    "schema_version": "AURA_PR_CONTINUITY_CAPSULE_V2_3",
    "harness_version": "AURA_ARCH_V2_3",
    "commit_time_authorization_required_for_durable_effects": true
  },
  "minimum_fidelity_fields": [
    "repository",
    "pr_number",
    "phase",
    "base_sha",
    "head_sha",
    "state",
    "objective",
    "non_objectives",
    "scope",
    "authority_boundary",
    "canonical_owners",
    "accepted_input_model",
    "decisions",
    "invariants",
    "execution_state.stale",
    "findings",
    "root_cause_groups",
    "rejected_approaches",
    "rollback.last_known_green_sha",
    "authorized_next_action",
    "durable_promotion",
    "harness_version",
    "delegation_state",
    "communication_state",
    "jspace_projection",
    "commit_authorization",
    "verification_independence"
  ],
  "convergence": {
    "weights": {
      "P0_root_cause": 13,
      "P1_root_cause": 8,
      "P2_root_cause": 5,
      "P3_root_cause": 2,
      "critical_regression": 13,
      "scope_or_authority_violation": 13,
      "stale_execution_action": 8,
      "verification_plane_conflict": 5,
      "repeated_rejected_approach": 5,
      "unclassified_finding": 3,
      "covert_channel_attempt": 13,
      "second_plane_attempt": 13,
      "authority_laundering": 13,
      "stale_commit_authorization": 13,
      "jspace_authority_escalation": 13,
      "verifier_independence_failure": 8
    },
    "strict_decrease_required_for_promotion": true,
    "max_promoted_transactions_per_review_wave": 3,
    "max_attempts_same_invariant_family": 2,
    "max_consecutive_non_improving_candidates": 2,
    "max_critical_regressions_before_rollback": 1,
    "threat_model_expansion_stop_ratio": 0.25
  },
  "rollback_triggers": [
    "critical_invariant_regression",
    "exact_scope_failure",
    "new_authority_or_policy_plane",
    "required_contract_test_failure",
    "non_decreasing_burden",
    "unapproved_threat_model_change",
    "finding_not_reproduced",
    "out_of_scope_edit",
    "stale_observation_dependency",
    "undeclared_coordination_channel",
    "second_communications_or_control_plane",
    "authority_laundering_detected",
    "commit_authorization_stale_or_mismatched",
    "jspace_authority_escalation",
    "verifier_independence_failure"
  ],
  "architectural_lenses": [
    "identity_and_provenance",
    "parse_bind_admit",
    "atomicity_and_transactions",
    "lifecycle_and_resumability",
    "concurrency_and_lock_scope",
    "ambient_state_vs_sealed_capability",
    "persistence_and_rehydration",
    "current_truth_vs_caller_echo",
    "canonical_ownership",
    "schema_semantic_documentation_parity",
    "resource_and_aggregate_bounds",
    "clean_checkout_reproducibility",
    "exact_head_scope_generated_artifacts",
    "cross_layer_contract",
    "test_realism_and_branch_reachability",
    "accepted_input_and_threat_model",
    "context_freshness",
    "rollback_and_partial_state",
    "budget_arithmetic",
    "authority_non_escalation",
    "multi_agent_channel_integrity",
    "covert_channel_resistance",
    "origin_non_malleability",
    "commit_time_authorization",
    "verifier_independence",
    "jspace_working_set_governance"
  ],
  "durable_promotion_required_before_deletion": true,
  "external_review": {
    "findings_only": true,
    "auto_apply_fixes": false,
    "full_base_to_head_review": true,
    "counterexample_required_for_blocker": true,
    "invariant_mapping_required": true
  },
  "authority": {
    "content_may_grant_authority": false,
    "derived_state_may_increase_authority": false,
    "origin_binding_non_malleable": true,
    "trusted_tool_echo_may_upgrade_origin": false,
    "summarization_may_upgrade_origin": false,
    "consensus_may_upgrade_authority": false,
    "delegation_monotonicity_required": true,
    "commit_time_reauthorization_required": true,
    "endpoint_success_is_authorization": false
  },
  "agent_communication": {
    "declared_channels_only": true,
    "runtime_derived_identity_required": true,
    "typed_envelopes_required": true,
    "canonicalization_required": true,
    "origin_propagation_required": true,
    "message_digest_required": true,
    "delivery_receipt_required": true,
    "size_rate_queue_bounds_required": true,
    "storage_channel_controls_required": true,
    "timing_channel_controls_required": true,
    "behavioral_channel_controls_required": true,
    "shared_files_are_potential_channels": true,
    "shared_cache_is_potential_channel": true,
    "shared_status_is_potential_channel": true,
    "jspace_is_potential_channel": true,
    "undeclared_channel_action": "BLOCK_AND_RECORD_FINDING"
  },
  "jspace": {
    "enabled": true,
    "role": "bounded_advisory_deliberative_working_set",
    "codec_version": "AURA_JSPACE_CODEC_V0",
    "packet_prefix": "J0",
    "default_active_limit": 25,
    "max_active_limit": 25,
    "authoritative": false,
    "patch_authority": false,
    "vsa_patch_authority": false,
    "persistent_truth": false,
    "reconstructable": true,
    "head_binding_required": true,
    "workspace_binding_required": true,
    "phase_hash_binding_required": true,
    "origin_binding_required": true,
    "freshness_required": true,
    "secret_material_forbidden": true,
    "stale_action": "RECONSTRUCT_OR_DISABLE"
  },
  "verification_independence": {
    "required_for_promotion": true,
    "raw_vote_count_is_independence": false,
    "shared_origin_must_be_recorded": true,
    "shared_model_session_must_be_recorded": true,
    "shared_tool_context_must_be_recorded": true,
    "manufactured_corroboration_may_upgrade_trust": false,
    "exact_contradiction_blocks_majority_override": true
  },
  "commit_authorization": {
    "required_for_durable_effects": true,
    "fresh_witness_required": true,
    "same_effect_binding_required": true,
    "causal_prior_required": true,
    "current_eligibility_required": true,
    "current_head_required": true,
    "current_workspace_required": true,
    "current_resource_identity_required": true,
    "current_lease_required": true,
    "dependency_and_threat_model_freshness_required": true,
    "proof_freshness_required": true,
    "verifier_independence_required": true,
    "governance_disposition_required": true,
    "mismatch_action": "REPLAN_OR_REFUSE"
  }
}
